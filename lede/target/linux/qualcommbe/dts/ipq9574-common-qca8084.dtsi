/* QCA8084 PCS1 QXGMII to IPQ9574 PCS0, with four integrated PHYs.
 * Reset wiring, port names, MAC cells and front-panel LEDs stay on the board.
 */
#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
#include <dt-bindings/net/qcom,qca808x.h>
#include <dt-bindings/reset/qcom,qca8k-nsscc.h>

/ {
	clocks {
		qca8084_uniphy1_rx312p5m: qca8k-uniphy1-rx312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};

		qca8084_uniphy1_tx312p5m: qca8k-uniphy1-tx312p5m {
			compatible = "fixed-clock";
			clock-frequency = <312500000>;
			#clock-cells = <0>;
		};
	};
};

&mdio {
	qca8084_nsscc: clock-controller@18 {
		compatible = "qcom,qca8084-nsscc";
		reg = <0x18>;
		clocks = <&cmn_pll ETH0_50MHZ_CLK>,
			 <0>,
			 <0>,
			 <0>,
			 <0>,
			 <&qca8084_uniphy1_rx312p5m>,
			 <&qca8084_uniphy1_tx312p5m>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	qca8084_phy_package: ethernet-phy-package@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8084-package";
		reg = <1>;
		clocks = <&qca8084_nsscc NSS_CC_APB_BRIDGE_CLK>,
			 <&qca8084_nsscc NSS_CC_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_TLMM_CLK>,
			 <&qca8084_nsscc NSS_CC_TLMM_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_CNOC_AHB_CLK>,
			 <&qca8084_nsscc NSS_CC_MDIO_AHB_CLK>;
		clock-names = "apb_bridge",
			      "ahb",
			      "sec_ctrl_ahb",
			      "tlmm",
			      "tlmm_ahb",
			      "cnoc_ahb",
			      "mdio_ahb";
		resets = <&qca8084_nsscc NSS_CC_GEPHY_FULL_ARES>;
		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;
		qcom,package-mode = <QCA808X_PCS1_10G_QXGMII_PCS0_UNUNSED>;

		qca8084_phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <1>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY0_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY0_SYS_ARES>;
			qcom,xpcs-channel = <0>;
		};

		qca8084_phy2: ethernet-phy@2 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <2>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY1_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY1_SYS_ARES>;
			qcom,xpcs-channel = <1>;
		};

		qca8084_phy3: ethernet-phy@3 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <3>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY2_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY2_SYS_ARES>;
			qcom,xpcs-channel = <2>;
		};

		qca8084_phy4: ethernet-phy@4 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <4>;
			clocks = <&qca8084_nsscc NSS_CC_GEPHY3_SYS_CLK>;
			resets = <&qca8084_nsscc NSS_CC_GEPHY3_SYS_ARES>;
			qcom,xpcs-channel = <3>;
		};

		pcs-phy@6 {
			compatible = "qcom,qca8k-pcs-phy";
			reg = <6>;
			clocks = <&qca8084_nsscc NSS_CC_SRDS1_SYS_CLK>,
				 <&qca8084_uniphy1_tx312p5m>,
				 <&qca8084_uniphy1_rx312p5m>;
			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root";
			resets = <&qca8084_nsscc NSS_CC_SRDS1_SYS_ARES>;
		};

		xpcs-phy@7 {
			compatible = "qcom,qca8k-xpcs-phy";
			reg = <7>;
			#address-cells = <1>;
			#size-cells = <0>;
			resets = <&qca8084_nsscc NSS_CC_XPCS_ARES>;

			channel@0 {
				reg = <0>;
				clocks = <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC1_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC1_TX_CLK_SRC>;
				clock-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx",
					      "rx_src",
					      "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_SRDS1_CH0_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC1_GEPHY0_TX_ARES>;
				reset-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx";
			};

			channel@1 {
				reg = <1>;
				clocks = <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC2_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC2_TX_CLK_SRC>;
				clock-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx",
					      "rx_src",
					      "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_SRDS1_CH1_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC2_GEPHY1_TX_ARES>;
				reset-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx";
			};

			channel@2 {
				reg = <2>;
				clocks = <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC3_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC3_TX_CLK_SRC>;
				clock-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx",
					      "rx_src",
					      "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_SRDS1_CH2_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC3_GEPHY2_TX_ARES>;
				reset-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx";
			};

			channel@3 {
				reg = <3>;
				clocks = <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
					 <&qca8084_nsscc NSS_CC_MAC4_RX_CLK_SRC>,
					 <&qca8084_nsscc NSS_CC_MAC4_TX_CLK_SRC>;
				clock-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx",
					      "rx_src",
					      "tx_src";
				resets = <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_XGMII_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_TX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_SRDS1_CH3_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_RX_ARES>,
					 <&qca8084_nsscc NSS_CC_MAC4_GEPHY3_TX_ARES>;
				reset-names = "xgmii_rx",
					      "xgmii_tx",
					      "xpcs_rx",
					      "xpcs_tx",
					      "port_rx",
					      "port_tx";
			};
		};
	};
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		ppe_port1: port@1 {
			reg = <1>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy1>;
			managed = "in-band-status";
			pcs-handle = <&pcs0_ch0>;
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};

		ppe_port2: port@2 {
			reg = <2>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy2>;
			managed = "in-band-status";
			pcs-handle = <&pcs0_ch1>;
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};

		ppe_port3: port@3 {
			reg = <3>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy3>;
			managed = "in-band-status";
			pcs-handle = <&pcs0_ch2>;
			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};

		ppe_port4: port@4 {
			reg = <4>;
			phy-mode = "10g-qxgmii";
			phy-handle = <&qca8084_phy4>;
			managed = "in-band-status";
			pcs-handle = <&pcs0_ch3>;
			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};
