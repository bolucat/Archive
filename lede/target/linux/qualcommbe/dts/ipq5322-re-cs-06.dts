/dts-v1/;

#include "ipq5332-common.dtsi"
#include "ipq5332-common-qca8386.dtsi"
#include "ipq5332-common-wifi.dtsi"

/ {
	model = "JDCloud RE-CS-06";
	compatible = "jdcloud,re-cs-06", "qcom,ipq5332";

	aliases {
		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_green;
		led-upgrade = &led_system_red;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-wps {
			label = "wps";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};

		button-reset {
			label = "reset";
			gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_system_red: system-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		};

		led_system_green: system-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
		};
	};

	usb_fixed_5p0: regulator-usb-5v {
		compatible = "regulator-fixed";
		regulator-name = "usb-fixed-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <2>;
};

&xo_clk {
	clock-frequency = <24000000>;
};

&mdio {
	status = "okay";
	phy-reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
};

&qca8386 {
	/* Use the same four-PHY switch mode as RE-CS-08. The OEM instead
	 * routes PHY4 through PCS0 to PPE port 2; the copper numbering is
	 * unchanged when PHY4 is attached to the switch MAC4.
	 */
	ports {
		port@1 {
			label = "lan1";
			nvmem-cells = <&lan_macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		port@2 {
			label = "lan2";
			nvmem-cells = <&lan_macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		port@3 {
			label = "lan3";
			nvmem-cells = <&lan_macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		port@4 {
			label = "wan";
			nvmem-cells = <&wan_macaddr 0>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&pcs1 {
	status = "disabled";
};

&pcie0_phy {
	status = "okay";
	compatible = "qcom,ipq5332-usb-uniphy";
	clocks = <&gcc GCC_USB0_PIPE_CLK>,
		 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
		 <&gcc GCC_PCIE3X1_PHY_AHB_CLK>;
	clock-names = "pipe", "phy_cfg_ahb", "phy_ahb";
	resets = <&gcc GCC_USB0_PHY_BCR>;
	reset-names = "por_rst";
	#clock-cells = <0>;
	#phy-cells = <0>;
	clock-output-names = "usb0_pipe_clk_src";
	qcom,phy-usb-mux-sel = <&tcsr 0x10540>;
	vdd-supply = <&usb_fixed_5p0>;

	/delete-property/ num-lanes;
};

&usb {
	status = "okay";
	clocks = <&gcc GCC_USB0_MASTER_CLK>,
		 <&gcc GCC_USB0_SLEEP_CLK>,
		 <&gcc GCC_USB0_MOCK_UTMI_CLK>,
		 <&gcc GCC_USB0_AUX_CLK>,
		 <&gcc GCC_USB0_LFPS_CLK>;
	clock-names = "core", "sleep", "mock_utmi", "aux", "lfps";

	/delete-property/ qcom,select-utmi-as-pipe-clk;
};

&usb_dwc {
	status = "okay";
	phys = <&usbphy0>, <&pcie0_phy>;
	phy-names = "usb2-phy", "usb3-phy";
	dr_mode = "host";
	maximum-speed = "super-speed";
};

&usbphy0 {
	status = "okay";
	vdd-supply = <&usb_fixed_5p0>;
};

&sdhc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_pins>;
	pinctrl-names = "default";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				block-partition-factory {
					partname = "factory";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						lan_macaddr: macaddr@0 {
							compatible = "mac-base";
							reg = <0x0 0x6>;
							#nvmem-cell-cells = <1>;
						};

						wan_macaddr: macaddr@6 {
							compatible = "mac-base";
							reg = <0x6 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio31", "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio24", "gpio33", "gpio49";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&wifi0 {
	qcom,board-id = <22>;
	nvmem-cells = <&lan_macaddr 2>;
	nvmem-cell-names = "mac-address";
};

&wifi1 {
	qcom,board-id = <2>;
	nvmem-cells = <&lan_macaddr 3>;
	nvmem-cell-names = "mac-address";
};
