// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)

/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	model = "GL.iNet GL-BE9300 (Flint 3)";
	compatible = "gl.inet,gl-be9300", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* TZ apps region is SBL-configured per board; Flint 3 vendor
		 * DT places it at 0x49b00000 (BE6500 uses 0x49600000). */
		tzapp: tzapp@49b00000 {
			reg = <0x0 0x49b00000 0x0 0x00600000>;
			no-map;
		};

		/*
		 * UserPD host DDR / BDF window. Deliberately an overlapping
		 * sub-window of the tail of q6_region: the Q6 images end below
		 * 0x4b500000, so the code occupies the first 12 MiB and this
		 * the remaining 23 MiB. 0x4a900000 + 0xc00000 = 0x4b500000,
		 * exactly what the vendor DT states as qcom,bdf-addr.
		 * of_reserved_mem logs "OVERLAP DETECTED" for this and
		 * continues; that is expected, not a fault.
		 */
		q6_host_ddr: host-ddr@4b500000 {
			reg = <0x0 0x4b500000 0x0 0x01700000>;
			no-map;
		};

		m3_dump: m3-dump@4cc00000 {
			reg = <0x0 0x4cc00000 0x0 0x100000>;
			no-map;
		};

		/* Not consumed by ath12k; reserved so Linux keeps out of the
		 * coresight ETR dump window the vendor DT also reserves. */
		q6_etr: q6-etr-dump@4cd00000 {
			reg = <0x0 0x4cd00000 0x0 0x100000>;
			no-map;
		};

		q6_caldb: q6-caldb@4ce00000 {
			reg = <0x0 0x4ce00000 0x0 0x500000>;
			no-map;
		};

		/*
		 * Persist the kernel log across a reboot. This board has no
		 * usable serial console, so a boot loop is otherwise silent:
		 * ramoops keeps dmesg and the console in RAM through a warm
		 * reset and exposes them under /sys/fs/pstore on the next boot
		 * (including a TFTP initramfs rescue boot).
		 *
		 * q6-caldb now ends at 0x4d2fffff and mlo-global-mem starts at
		 * 0x4db00000, so 0x4d300000..0x4dafffff (8 MiB) is unreserved and
		 * ramoops sits at the top of it - verified against the live
		 * "OF: reserved mem" map, not just the DTS.
		 * Deliberately mapped (no "no-map"): ramoops must write here.
		 */
		ramoops@4da00000 {
			compatible = "ramoops";
			reg = <0x0 0x4da00000 0x0 0x100000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
			pmsg-size = <0x20000>;
		};

		mlo_mem: mlo-global-mem@4db00000 {
			reg = <0x0 0x4db00000 0x0 0x01200000>;
			no-map;
		};

		qcn9274_host_ddr: qcn9274-host-ddr@4ed00000 {
			reg = <0x0 0x4ed00000 0x0 0x03200000>;
			no-map;
		};
	};

	soc@0 {
		leds {
			compatible = "gpio-leds";
			pinctrl-0 = <&leds_pins>;
			pinctrl-names = "default";
			status = "okay";

			led@32 {
				label = "blue:run";
				gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
				default-state = "on";
			};

			led@33 {
				label = "white:system";
				gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};
		};

		gpio_keys {
			compatible = "gpio-keys";
			pinctrl-0 = <&button_pins>;
			pinctrl-names = "default";
			status = "okay";

			reset {
				label = "reset";
				linux,code = <KEY_RESTART>;
				gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
				linux,input-type = <1>;
			};
		};

		fan0: pwm-fan {
			compatible = "pwm-fan";
			pinctrl-0 = <&fan_pins>;
			pinctrl-names = "default";
			pwms = <&pwm 3 40000 0>;
			interrupt-parent = <&tlmm>;
			interrupts = <36 IRQ_TYPE_EDGE_RISING>;
			pulses-per-revolution = <2>;
			cooling-levels = <36 128 192 255>;
			#cooling-cells = <2>;
		};

		mdio: mdio@90000 {
			compatible = "qcom,ipq4019-mdio";
			reg = <0x90000 0x64>;
			pinctrl-0 = <&mdio1_pins &mdio0_pins>;
			pinctrl-names = "default";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clock-names = "gcc_mdio_ahb_clk";
			status = "disabled";
		};
	};

	thermal-zones {
		cpu-top-thermal {
			polling-delay = <1000>;

			trips {
				fan_trip_high: active-high {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "active";
				};

				fan_trip_med: active-med {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "active";
				};

				fan_trip_low: active-low {
					temperature = <50000>;
					hysteresis = <2000>;
					type = "active";
				};
			};

			cooling-maps {
				fan-active-high {
					cooling-device = <&fan0 3 3>;
					trip = <&fan_trip_high>;
				};

				fan-active-med {
					cooling-device = <&fan0 2 2>;
					trip = <&fan_trip_med>;
				};

				fan-active-low {
					cooling-device = <&fan0 1 1>;
					trip = <&fan_trip_low>;
				};
			};
		};
	};
};

/ {
	usb_vbus_5v: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm {
	#pwm-cells = <2>;
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	used-pwm-indices = <0>, <0>, <0>, <1>;
	status = "okay";
};

&tlmm {
	leds_pins: leds_pinmux {
		led_blue {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_white {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	button_pins: button_pins {
		reset_button {
			pins = "gpio17";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pwm_pins: pwm_pinmux {
		pwm1 {
			pins = "gpio29";
			function = "pwm1";
			drive-strength = <8>;
		};
	};

	fan_pins: fan_pins {
		pwr {
			pins = "gpio34";
			function = "gpio";
			bias-pull-up;
			output-high;
		};
		speed {
			pins = "gpio36";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	usb_pins: usb_pins {
		usb_pwr {
			pins = "gpio16";
			function = "gpio";
			bias-pull-up;
			output-high;
		};
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio13";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio12";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_default: pcie1-default-state {
		clkreq-n-pins {
			pins = "gpio46";
			function = "pcie1_clk";
			drive-strength = <8>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio47";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio48";
			function = "pcie1_wake";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio0_pins: mdio0-state {
		mux_0 {
			pins = "gpio25";
			function = "mdc0";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio26";
			function = "mdio0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio1_pins: mdio1-state {
		mux_0 {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	mdio_clk_fixup; /* MDIO clock sequence fix up flag */

	/*
	 * RTL8221B-VB-CG 2.5G WAN PHY. Vendor DT lists two MDIO reset
	 * GPIOs: 51 and 24. Per our May bring-up notes 51 is the RTL8221B
	 * and 24 the RTL8372N switch (BE6500 uses 24 for its PHY — if the
	 * WAN PHY fails to probe, swap to 24 here).
	 */
	phy: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c849";
		reg = <1>;
		reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
	};

	/*
	 * RTL8372N switch (4x 2.5G LAN + 10G SerDes uplink to xgmac1).
	 * No reset-gpios: U-Boot leaves the switch initialized with SDS0
	 * in 10G mode and port 3 linked; the driver re-inits from there.
	 * The four sdsN-rx/tx-swap flags are required on this board, same as
	 * BE6500. Without them the 10G CPU link still reports up, but no
	 * traffic crosses it in either direction (bench-verified 2026-07-27:
	 * swap_cfg 0x0 = dead LAN path, swap_cfg 0xf = LAN path works).
	 */
	rtl837x: rtl837x-dsa@29 {
		compatible = "realtek,rtl837x";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <29>;
		rtl837x,sds0mode = "10g-kr";
		gpio-controller;
		#gpio-cells = <2>;

		sds0-rx-swap;
		sds0-tx-swap;
		sds1-rx-swap;
		sds1-tx-swap;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@3 {
				reg = <3>;
				label = "cpu";
				ethernet = <&xgmac1>;
				phy-mode = "10gbase-r";

				fixed-link {
					speed = <10000>;
					full-duplex;
				};
			};

			/*
			 * Front-panel jack mapping, verified 2026-07-27 by
			 * walking one cable through all four jacks and
			 * watching which netdev gained carrier:
			 * LAN1=port7, LAN2=port6, LAN3=port5, LAN4=port4.
			 * This matches the vendor device tree; the May-2026
			 * note that had lan2/lan3 the other way round was
			 * wrong.
			 */
			port@4 {
				reg = <4>;
				label = "lan4";
				phy-mode = "internal";
			};

			port@5 {
				reg = <5>;
				label = "lan3";
				phy-mode = "internal";
			};

			port@6 {
				reg = <6>;
				label = "lan2";
				phy-mode = "internal";
			};

			port@7 {
				reg = <7>;
				label = "lan1";
				phy-mode = "internal";
			};
		};
	};
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			phy-mode = "10gbase-r";
			label = "lan";
			pcs-handle = <&pcs0_ch0>;
			phy-handle = <&rtl837x>;
			nvmem-cells = <&base_macaddr 2>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";

			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		xgmac2: port@2 {
			reg = <2>;
			phy-mode = "usxgmii";
			managed = "in-band-status";
			label = "wan";
			pcs-handle = <&pcs1_ch0>;
			phy-handle = <&phy>;
			nvmem-cells = <&base_macaddr 0>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&pcie0_phy {
	status = "okay";
	compatible = "qcom,ipq5332-usb-uniphy";
	clocks = <&gcc GCC_USB0_PIPE_CLK>,
		 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
		 <&gcc GCC_PCIE3X1_PHY_AHB_CLK>;
	clock-names = "pipe", "phy_cfg_ahb", "phy_ahb";
	resets = <&gcc GCC_USB0_PHY_BCR>;
	reset-names = "por_rst";
	#clock-cells = <0>;
	#phy-cells = <0>;
	clock-output-names = "usb0_pipe_clk_src";
	qcom,phy-usb-mux-sel = <&tcsr 0x10540>;
	vdd-supply = <&usb_vbus_5v>;

	/delete-property/ num-lanes;
};

&usb {
	pinctrl-0 = <&usb_pins>;
	pinctrl-names = "default";
	status = "okay";
	clocks = <&gcc GCC_USB0_MASTER_CLK>,
		 <&gcc GCC_USB0_SLEEP_CLK>,
		 <&gcc GCC_USB0_MOCK_UTMI_CLK>,
		 <&gcc GCC_USB0_AUX_CLK>,
		 <&gcc GCC_USB0_LFPS_CLK>;
	clock-names = "core", "sleep", "mock_utmi", "aux", "lfps";

	/delete-property/ qcom,select-utmi-as-pipe-clk;
};

&usb_dwc {
	status = "okay";
	phys = <&usbphy0>, <&pcie0_phy>;
	phy-names = "usb2-phy", "usb3-phy";
	dr_mode = "host";
	maximum-speed = "super-speed";
};


&usbphy0 {
	status = "okay";
	vdd-supply = <&usb_vbus_5v>;
};

/* eMMC 5.1, 8 GB — Flint 3 boots from eMMC (BE6500 is SPI-NAND). */
&sdhc {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		partitions {
			compatible = "gpt-partitions";

			block-partition-art {
				partname = "0:ART";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					base_macaddr: mac-address@a {
						compatible = "mac-base";
						reg = <0xa 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pinctrl-0 = <&pcie1_default>;
	pinctrl-names = "default";

	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;

	pcie@0 {
		/*
		 * QCN9274/QCN6274 dualmac package: MAC0 = 5 GHz,
		 * MAC1 = 6 GHz. OTP board-id is unprovisioned (0xff), so
		 * both board-id and radio count come from DT. Vendor CNSS
		 * uses board_id 0x1019 for this radio.
		 */
		wifi1: pcie@0 {
			compatible = "pci17cb,1109";
			reg = <0x00010000  0 0 0 0>;
			memory-region = <&qcn9274_host_ddr>, <&mlo_mem>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,ath12k-fw-memory-mode = <1>;
			qcom,board-id = <0x1019>;
			qcom,num-radios = <2>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi0_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi0_wsi_tx>;
					};
				};
			};
		};
	};
};

/*
 * The bootstrap pins for the board select the XO clock frequency that
 * supports 48 MHZ or 96 MHZ. This setting automatically enables the
 * right dividers, to ensure the reference clock output from WiFi to
 * the CMN PLL is 48 MHZ.
 */
&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

/*
 * The frequency of xo_board is fixed to 24 MHZ, which is routed
 * from WiFi output clock 48 MHZ divided by 2.
 */
&xo_board {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};

/* IPQ5332 integrated 2.4 GHz radio (AHB). Vendor board_id 0x12 = 18,
 * same as GL-BE6500. */
&wifi0 {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
	/* Order matters: ath12k still resolves the UserPD image by INDEX 0
	 * (ahb.c), so "q6-region" must stay first. The rest are by name. */
	memory-region = <&q6_region>, <&q6_host_ddr>, <&m3_dump>, <&q6_caldb>,
			<&mlo_mem>, <&q6_etr>;
	memory-region-names = "q6-region", "host-ddr-mem", "m3-dump", "q6-caldb",
			      "mlo-global-mem", "q6-etr-dump";
	qcom,board-id = <18>;
	qcom,rproc = <&q6v5_wcss>;
	qcom,wsi-controller;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			wifi0_wsi_tx: endpoint {
				remote-endpoint = <&wifi1_wsi_rx>;
			};
		};

		port@1 {
			reg = <1>;

			wifi0_wsi_rx: endpoint {
				remote-endpoint = <&wifi1_wsi_tx>;
			};
		};
	};
};

&q6v5_wcss {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw0.mdt";
	qcom,bootargs_smem = <507>;
	qcom,bootargs_version = <2>;
	upd-firmware-names = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt";
	status = "okay";
};

/*
 * The target patch that adds q6_region sizes it at 0x2b00000 (43 MiB) for the
 * RDP reference board. The live vendor DT for this board says the Q6 span is
 * wcnss@4a900000 + 0x2300000 (35 MiB), ending at 0x4cc00000 where m3-dump
 * begins. Leaving it at 43 MiB would overlap m3-dump, q6-etr-dump and q6-caldb,
 * and of_reserved_mem only warns - firmware would then be free to write over
 * caldata. Our ath12k blobs reach 0x4b2cbff8, so 35 MiB leaves ~25 MiB spare.
 */
&q6_region {
	reg = <0x0 0x4a900000 0x0 0x02300000>;
};
