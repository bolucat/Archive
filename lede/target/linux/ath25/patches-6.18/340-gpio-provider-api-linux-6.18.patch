+	return 0;
 }
 
 static int ar5312_gpio_dir_in(struct gpio_chip *chip, unsigned gpio)
@@ -97,7 +99,7 @@
 		return PTR_ERR(ar5312_mem);
 
 	ar5312_gpio_chip.parent = dev;
-	ret = gpiochip_add(&ar5312_gpio_chip);
+	ret = gpiochip_add_data(&ar5312_gpio_chip, NULL);
