+
+/* Legacy BCM63xx pin controllers can share non-DT syscon devices. */
+static int syscon_platform_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regmap_config config = syscon_regmap_config;
+	struct resource *res;
+	struct regmap *regmap;
+	void __iomem *base;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < 4)
+		return -EINVAL;
+
+	base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!base)
+		return -ENOMEM;
+
+	config.max_register = resource_size(res) - 4;
+	config.max_register_is_0 = !config.max_register;
+	regmap = devm_regmap_init_mmio(dev, base, &config);
+	return PTR_ERR_OR_ZERO(regmap);
+}
+
+static struct platform_driver syscon_platform_driver = {
+	.driver.name = "syscon",
+	.probe = syscon_platform_probe,
+};
+
+static int __init syscon_platform_init(void)
+{
+	return platform_driver_register(&syscon_platform_driver);
+}
+postcore_initcall(syscon_platform_init);
