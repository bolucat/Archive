Subject: [PATCH] arc: strip compiler runtime debug information before linking

ARC links libgcc into vmlinux. Its GCC-internal DWARF contains complex
floating-point types that pahole cannot encode as BTF. Link a local copy
with debugging sections stripped, preserving runtime code and symbols
and BTF generation for kernel code.

Signed-off-by: lean <chenlin@fnnas.com>

--- a/arch/arc/Makefile
+++ b/arch/arc/Makefile
@@ -72,7 +72,7 @@
 cflags-$(CONFIG_CPU_BIG_ENDIAN)		+= -mbig-endian
 ldflags-$(CONFIG_CPU_BIG_ENDIAN)	+= -EB
 
-LIBGCC	= $(shell $(CC) $(cflags-y) --print-libgcc-file-name)
+export LIBGCC	= $(shell $(CC) $(cflags-y) --print-libgcc-file-name)
 
 # Modules with short calls might break for calls into builtin-kernel
 KBUILD_CFLAGS_MODULE	+= -mlong-calls -mno-millicode
@@ -87,7 +87,7 @@
 core-$(CONFIG_ARC_PLAT_AXS10X)	+= arch/arc/plat-axs10x/
 core-$(CONFIG_ARC_SOC_HSDK)	+= arch/arc/plat-hsdk/
 
-libs-y		+= arch/arc/lib/ $(LIBGCC)
+libs-y		+= arch/arc/lib/ arch/arc/lib/libgcc.a
 
 boot		:= arch/arc/boot
 
--- a/arch/arc/lib/Makefile
+++ b/arch/arc/lib/Makefile
@@ -13,3 +13,12 @@
 else
 lib-$(CONFIG_ISA_ARCV2)		+=memcpy-archs.o
 endif
+
+# The compiler runtime has non-kernel DWARF types unsupported by BTF.
+always-y += libgcc.a
+
+quiet_cmd_arc_libgcc = OBJCOPY $@
+      cmd_arc_libgcc = $(OBJCOPY) --strip-debug $< $@
+
+$(obj)/libgcc.a: $(LIBGCC) FORCE
+	$(call if_changed,arc_libgcc)
