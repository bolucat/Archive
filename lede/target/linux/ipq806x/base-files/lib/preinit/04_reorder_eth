. /lib/functions.sh
. /lib/functions/system.sh


preinit_reorder_eth() {
	[ "$(get_linux_version)" -ge "618000" ] && return 0
	case $(board_name) in
	ubnt,unifi-ac-hd)
		ip link set eth0 name ethtmp
		ip link set eth1 name eth0
		ip link set ethtmp name eth1
		;;
	esac
}

boot_hook_add preinit_main preinit_reorder_eth
