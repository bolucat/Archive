Subject: [PATCH] ssdk: report native Flow hardware transaction failures

Identify the failed transaction step while retaining gate invalidation and
rollback. Rate-limit reports and omit expected transient retry conditions.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/src/ref/ref_flow_hw.c
+++ b/src/ref/ref_flow_hw.c
@@ -27,13 +27,16 @@
 		if (hw->slots[i].ready) return true;
 	return false;
 }
-static int failed(struct ssdk_flow_hw *hw, int error)
+static int failed_at(struct ssdk_flow_hw *hw, int error, const char *operation, unsigned int line)
 {
 	/* Stop other installed connections too: an incomplete ACL relocation
 	 * or invalidated path must never be followed by a speculative resume. */
 	ssdk_flow_gate_invalidate(hw->dev);
+	if (error != -EAGAIN && error != -ESTALE)
+		pr_warn_ratelimited("ssdk_flow: %s:%u failed: %d\n", operation, line, error);
 	return error;
 }
+#define failed(hw, error) failed_at(hw, error, __func__, __LINE__)
 static int hw_install(void *ctx, unsigned int slot, const struct ssdk_flow_rule rules[2],
 		      const struct ssdk_flow_pair *pair, struct ssdk_flow_counts *baseline)
 {
