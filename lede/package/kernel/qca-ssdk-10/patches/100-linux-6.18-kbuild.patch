+		if (state->ops->read(state->ctx, i, &counts)) {
+			remove_slot(state, i); ret = -EIO;
+		}
+	}
+	mutex_unlock(&state->lock);
+	return ret;
+}
+static int flush_locked(struct ssdk_flow_state *state)
+{
+	unsigned int i;
+	int ret = 0;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (state->slots[i].used && remove_slot(state, i)) ret = -EIO;
+	for (i = 0; i < FLOW_ENTRIES; i++)
+		if (state->entries[i].used && state->entries[i].slot < 0) drop_entry(&state->entries[i]);
+	return ret;
+}
+int ssdk_flow_state_flush(struct ssdk_flow_state *state)
+{
+	int ret;
+	if (!state) return 0;
+	mutex_lock(&state->lock);
+	ret = flush_locked(state);
+	mutex_unlock(&state->lock);
+	return ret;
+}
+int ssdk_flow_state_destroy(struct ssdk_flow_state *state)
+{
+	int ret;
+	if (!state) return 0;
+	mutex_lock(&state->lock);
+	state->closed = true;
+	ret = flush_locked(state);
+	mutex_unlock(&state->lock);
+	if (!ret) kfree(state);
+	return ret;
+}
