+static int remove_slot(struct ssdk_flow_state *state, unsigned int index)
+{
+	struct ssdk_flow_slot *slot = &state->slots[index];
+	int ret = state->ops->remove(state->ctx, index);
+	if (ret) {
+		slot->quarantine = true;
+		return ret;
+	}
+	drop_entry(&state->entries[slot->entry[0]]);
+	drop_entry(&state->entries[slot->entry[1]]);
+	memset(slot, 0, sizeof(*slot));
+	return 0;
+}
+static int find_cookie(struct ssdk_flow_state *state, unsigned long cookie)
+{
+	unsigned int i;
+	for (i = 0; i < FLOW_ENTRIES; i++)
+		if (state->entries[i].used && state->entries[i].cookie == cookie)
+			return i;
+	return -1;
+}
+static bool same_rule(const struct ssdk_flow_rule *a, const struct ssdk_flow_rule *b)
+{
+	return !memcmp(&a->match, &b->match, sizeof(a->match)) &&
+		!memcmp(&a->translated, &b->translated, sizeof(a->translated)) &&
+		a->ingress_ifindex == b->ingress_ifindex && a->egress == b->egress &&
+		a->protocol == b->protocol && a->tcp_mask == b->tcp_mask &&
+		!memcmp(a->source, b->source, ETH_ALEN) &&
+		!memcmp(a->destination, b->destination, ETH_ALEN) &&
+		a->ingress_vid == b->ingress_vid && a->egress_vid == b->egress_vid &&
+		a->vlan_match == b->vlan_match && a->vlan_pop == b->vlan_pop &&
+		a->vlan_push == b->vlan_push;
