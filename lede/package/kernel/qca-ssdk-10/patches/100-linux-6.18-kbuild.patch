+extern ssdk_chip_type SSDK_CURRENT_CHIP_TYPE;
+static DEFINE_MUTEX(control_lock);
+static DECLARE_RWSEM(user_access);
+static bool native_owned, attached, initializing, changing, closing;
+static struct net_device *gmac[2];
+static struct ssdk_edma_vlan_config vlan_map;
+static struct ssdk_flow_engine *engine;
+static struct ssdk_flow_engine __rcu *notifier_engine;
+static struct flow_block *bound_block;
+static LIST_HEAD(driver_blocks);
+static void collect_work(struct work_struct *work);
+static DECLARE_DELAYED_WORK(collector, collect_work);
+
+static void release_devices(void)
+{
+	unsigned int i;
+	if (attached || initializing || engine || bound_block) return;
+	for (i = 0; i < 2; i++) if (gmac[i]) { dev_put(gmac[i]); gmac[i] = NULL; }
+}
+static int stop_engine(void)
+{
+	int ret;
+	if (!engine) return 0;
+	if (!closing) {
+		closing = true;
+		RCU_INIT_POINTER(notifier_engine, NULL);
+		synchronize_rcu();
+	}
+	ret = ssdk_flow_engine_destroy(engine);
+	if (ret) {
+		mod_delayed_work(system_wq, &collector, HZ);
+		return ret;
+	}
+	engine = NULL; closing = false;
+	down_write(&user_access); native_owned = false; up_write(&user_access);
+	module_put(THIS_MODULE);
+	release_devices(); return 0;
+}
+static int start_engine(void)
+{
+	struct ssdk_flow_resolver resolver = {};
+	ssdk_reg_map_info map;
+	int ret;
+	if (engine) return closing ? -EAGAIN : 0;
+	if (!attached || changing || !gmac[0] || !gmac[1] ||
+	    !vlan_map.default_vid[0] || !vlan_map.default_vid[1]) return -EAGAIN;
+	if (SSDK_CURRENT_CHIP_TYPE != CHIP_DESS || !qca_phy_priv_global ||
+	    !qca_phy_priv_global[0] || !qca_phy_priv_global[0]->hw_addr ||
+	    ssdk_switch_reg_access_mode_get(0) != HSL_REG_LOCAL_BUS) return -EOPNOTSUPP;
+	/* Never wait under control_lock for a configuration writer that can
+	 * call our VLAN notifier and need that same lock. */
+	if (!down_write_trylock(&user_access)) return -EBUSY;
+	if (native_owned) { up_write(&user_access); return -EBUSY; }
+	if (!try_module_get(THIS_MODULE)) { up_write(&user_access); return -ENODEV; }
+	native_owned = true; up_write(&user_access);
+	ssdk_switch_reg_map_info_get(0, &map);
+	resolver.gmac[0] = gmac[0]; resolver.gmac[1] = gmac[1]; resolver.vlans = &vlan_map;
+	ret = ssdk_flow_engine_create(0, qca_phy_priv_global[0]->hw_addr, map.size, &resolver, &engine);
+	if (ret) {
+		if (engine) stop_engine();
+		else {
+			down_write(&user_access); native_owned = false; up_write(&user_access);
+			module_put(THIS_MODULE);
+		}
+		return ret;
+	}
