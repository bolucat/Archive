+}
+int ssdk_flow_state_gc(struct ssdk_flow_state *state, unsigned long now)
+{
+	struct ssdk_flow_counts counts;
+	unsigned int i;
+	int ret;
+	mutex_lock(&state->lock);
+	ret = collect(state, now);
