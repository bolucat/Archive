+struct ssdk_flow_state *ssdk_flow_state_create(const struct ssdk_flow_ops *ops, void *ctx)
+{
+	struct ssdk_flow_state *state;
+	if (!ops || !ops->install || !ops->remove || !ops->read)
+		return NULL;
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
