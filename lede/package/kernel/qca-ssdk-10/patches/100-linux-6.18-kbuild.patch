--- a/include/ref/ssdk_flow_engine.h
+++ b/include/ref/ssdk_flow_engine.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_ENGINE_H
+#define _SSDK_FLOW_ENGINE_H
+#include <linux/io.h>
+#include "ssdk_flow_path.h"
+struct flow_cls_offload;
+struct ssdk_flow_engine;
+/* The outer owner excludes competing hardware writers and retains MMIO,
+ * GMACs until destroy succeeds. The VLAN snapshot is copied. Creation publishes an
+ * object before hardware access; even a failed create may require destroy
+ * retries. Never discard a non-NULL output pointer after an error. */
+int ssdk_flow_engine_create(unsigned int dev, void __iomem *base, size_t size,
+	const struct ssdk_flow_resolver *resolver, struct ssdk_flow_engine **out);
+/* Atomic notifier entry; caller guarantees object lifetime. */
+void ssdk_flow_engine_invalidate(struct ssdk_flow_engine *engine);
+/* Process-context callback/worker APIs. replace uses rtnl_trylock because
+ * nf_flowtable holds its block read lock while unbind can hold RTNL. A
+ * blocking RTNL acquisition there would invert those locks. */
+int ssdk_flow_engine_command(struct ssdk_flow_engine *engine, struct flow_cls_offload *flow);
+int ssdk_flow_engine_collect(struct ssdk_flow_engine *engine);
+int ssdk_flow_engine_flush(struct ssdk_flow_engine *engine);
+/* Switch VLAN PREPARE must suspend before hardware changes. Even a failed
+ * suspend remains suspended until end; the caller must veto that update.
+ * End copies COMMIT/FAILED's map; NULL keeps the previous map for ABORT. */
+int ssdk_flow_engine_vlan_begin(struct ssdk_flow_engine *engine);
+void ssdk_flow_engine_vlan_end(struct ssdk_flow_engine *engine,
+			      const struct ssdk_edma_vlan_config *config);
+/* Quiesce callbacks and atomic invalidators before destroy; retain on error. */
+int ssdk_flow_engine_destroy(struct ssdk_flow_engine *engine);
+#endif
--- a/include/ref/ssdk_flow_gate.h
+++ b/include/ref/ssdk_flow_gate.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_GATE_H
+#define _SSDK_FLOW_GATE_H
+#include <linux/types.h>
+#include <linux/io.h>
+/* The caller must retain the MMIO mapping and quiesce all notifier/callback
+ * users before release/unmap. Native ownership excludes other table writers.
+ * Process-context transactions must be serialized by the caller; epochs
+ * arbitrate asynchronous invalidation, not competing transaction owners.
+ * A failed claim may retain ownership if restoration also fails.
+ * pause/invalidate/write do not sleep and are usable in atomic context. */
+int ssdk_flow_gate_claim(unsigned int dev, void __iomem *base, size_t size);
+int ssdk_flow_gate_pause(unsigned int dev, u64 *epoch);
+int ssdk_flow_gate_invalidate(unsigned int dev);
+int ssdk_flow_gate_ack(unsigned int dev, u64 epoch);
+int ssdk_flow_gate_resume(unsigned int dev, u64 epoch);
+/* All owned resources must be gone before restoring the original gate bits.
+ * A failed release retains ownership and must be retried. */
+int ssdk_flow_gate_release(unsigned int dev);
+/* True only while ownership is valid (forwarding may still be paused). */
+bool ssdk_flow_gate_valid(unsigned int dev);
+/* Intercept SDK writes to gate registers to prevent a stale RMW from undoing
+ * an atomic invalidation. Returns true if the write has been performed. */
+bool ssdk_flow_gate_write(unsigned int dev, void __iomem *base, u32 offset, u32 value);
+#endif
--- a/include/ref/ssdk_flow_host.h
+++ b/include/ref/ssdk_flow_host.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_HOST_H
+#define _SSDK_FLOW_HOST_H
+#include <linux/types.h>
+#include <linux/if_ether.h>
+struct ssdk_flow_host;
+struct ssdk_flow_path {
+	__be32 address;
+	u16 vid;
+	u8 port;
+	u8 router[ETH_ALEN], neighbour[ETH_ALEN];
+};
+/* Serialize access and exclude autonomous learning/other table writers.
+ * Install router-MAC guards before get; revoke flow permissions before put.
+ * get publishes a cleanup handle before hardware writes, including on error.
+ * Hardware readback does not preserve the software NO_ROUTE operation flag. */
+struct ssdk_flow_host *ssdk_flow_host_create(unsigned int dev);
+int ssdk_flow_host_get(struct ssdk_flow_host *hosts, const struct ssdk_flow_path *path,
+		      int *handle, u16 *arp);
+int ssdk_flow_host_put(struct ssdk_flow_host *hosts, int handle);
+int ssdk_flow_host_destroy(struct ssdk_flow_host *hosts);
+#endif
--- a/include/ref/ssdk_flow_hw.h
+++ b/include/ref/ssdk_flow_hw.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_HW_H
+#define _SSDK_FLOW_HW_H
+#include "ssdk_flow_state.h"
+#include "ssdk_flow_host.h"
+struct ssdk_flow_acl_owner;
+struct ssdk_flow_napt;
+struct ssdk_flow_hw;
+/* Resolve each direction's egress next hop, physical port and VID. The resolver
+ * must also verify that each ingress is the reverse direction's egress path,
+ * including bridge/VLAN membership and the configured private NAT prefix.
+ * Resolution runs in process context with forwarding paused. It must not take
+ * a lock held by a synchronous VLAN invalidation notifier. */
+typedef int (*ssdk_flow_resolve_t)(void *ctx, const struct ssdk_flow_rule rules[2],
+				 struct ssdk_flow_path paths[2]);
+/* Borrow already initialized resource owners; retain them until hw destruction.
+ * The gate must be claimed and profiles applied before any install. Serialize
+ * all operations and exclude other table writers. After ANY transaction error,
+ * flush the state and revalidate/ack the gate before allowing new replacements.
+ * Atomic notifier invalidation may run concurrently. */
+struct ssdk_flow_hw *ssdk_flow_hw_create(unsigned int dev,
+	struct ssdk_flow_acl_owner *acl, struct ssdk_flow_host *hosts,
+	struct ssdk_flow_napt *napt, ssdk_flow_resolve_t resolve, void *ctx);
+extern const struct ssdk_flow_ops ssdk_flow_hw_ops;
+/* Destroy the connection state first; failure retains this object for retry. */
+int ssdk_flow_hw_destroy(struct ssdk_flow_hw *hw);
+#endif
--- a/include/ref/ssdk_flow_napt.h
+++ b/include/ref/ssdk_flow_napt.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_NAPT_H
+#define _SSDK_FLOW_NAPT_H
+#include "ssdk_flow_state.h"
+struct ssdk_flow_napt;
+/* Caller serializes access, excludes other NAT table writers, and revokes
+ * ACL permissions before remove/destroy. This layer never enables L3/NAT or
+ * grants a forwarding permission. create rejects pre-existing NAT resources. */
+struct ssdk_flow_napt *ssdk_flow_napt_create(unsigned int dev);
+int ssdk_flow_napt_add(struct ssdk_flow_napt *napt, unsigned int slot,
+		       const struct ssdk_flow_pair *pair, struct ssdk_flow_counts *baseline);
+int ssdk_flow_napt_read(struct ssdk_flow_napt *napt, unsigned int slot,
+			struct ssdk_flow_counts *counts);
+int ssdk_flow_napt_remove(struct ssdk_flow_napt *napt, unsigned int slot);
+int ssdk_flow_napt_destroy(struct ssdk_flow_napt *napt);
+#endif
--- a/include/ref/ssdk_flow_path.h
+++ b/include/ref/ssdk_flow_path.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_PATH_H
+#define _SSDK_FLOW_PATH_H
+#include "ssdk_flow_hw.h"
+#include "ssdk_edma.h"
+struct ssdk_flow_resolver {
+	unsigned int dev;
+	/* Retained by the outer owner; access serialized under RTNL then its
+	 * mutex. VLAN snapshot must remain immutable during resolution. */
+	struct net_device *gmac[2];
+	const struct ssdk_edma_vlan_config *vlans;
+	/* Claim/program the LAN private prefix, or reject a conflict with
+	 * existing flows. Invoked only after all paths have been verified. */
+	int (*prefix)(void *ctx, __be32 base, __be32 mask);
+	void *ctx;
+};
+/* Caller holds RTNL and has paused the forwarding gate. Notifiers must
+ * invalidate that gate before topology changes can race a later resume. */
+int ssdk_flow_resolve_paths(void *ctx, const struct ssdk_flow_rule rules[2],
+			    struct ssdk_flow_path paths[2]);
+/* Process-context hardware revalidation; does not acquire RTNL. */
+int ssdk_flow_path_alive(unsigned int dev, const struct ssdk_flow_path *path);
