+/* Use the board's PHY driver and phy-mode for external RGMII delays. */
+static int ssdk_dess_rgmii5_init(a_uint32_t dev_id)
+{
+	struct device_node *ports, *port, *phy_node;
+	struct phy_device *phydev;
+	phy_interface_t interface;
+	u32 id, value;
+	int ret = -ENODEV;
+
+	ports = of_get_child_by_name(qca_phy_priv_global[dev_id]->of_node, "ports");
+	if (!ports)
+		return -ENODEV;
+	for_each_available_child_of_node(ports, port) {
+		if (of_property_read_u32(port, "reg", &id) || id != 5)
+			continue;
+		ret = of_get_phy_mode(port, &interface);
+		if (ret)
+			break;
+		if (interface != PHY_INTERFACE_MODE_RGMII &&
+		    interface != PHY_INTERFACE_MODE_RGMII_ID &&
+		    interface != PHY_INTERFACE_MODE_RGMII_RXID &&
+		    interface != PHY_INTERFACE_MODE_RGMII_TXID) {
+			ret = -EINVAL;
+			break;
+		}
+		phy_node = of_parse_phandle(port, "phy-handle", 0);
+		phydev = of_phy_find_device(phy_node);
+		of_node_put(phy_node);
+		if (!phydev) {
+			ret = -EPROBE_DEFER;
+			break;
+		}
+		mutex_lock(&phydev->lock);
+		if (!phydev->drv) {
+			ret = -EPROBE_DEFER;
+		} else {
+			phydev->interface = interface;
+			ret = phy_init_hw(phydev);
+			if (!ret)
+				ret = phy_config_aneg(phydev);
+		}
+		mutex_unlock(&phydev->lock);
+		put_device(&phydev->mdio.dev);
+		break;
+	}
+	of_node_put(port);
+	of_node_put(ports);
+	if (ret)
+		return ret;
+
+	ret = qca_switch_reg_read(dev_id, 0x4, (a_uint8_t *)&value, 4);
+	if (ret)
+		return ret;
+	value |= BIT(10); /* RGMII clock source, matching IPQ4019 ESS. */
+	ret = qca_switch_reg_write(dev_id, 0x4, (a_uint8_t *)&value, 4);
+	if (ret)
+		return ret;
+	/* Polling enables TX/RX after reading the actual PHY link and speed. */
+	value = 0;
+	return qca_switch_reg_write(dev_id, AR8327_REG_PORT_STATUS(5),
+				    (a_uint8_t *)&value, 4);
+}
