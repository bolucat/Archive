+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/atomic.h>
+#include <linux/err.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/rtnetlink.h>
+#include <linux/slab.h>
+#include <net/flow_offload.h>
+#include "ssdk_flow_engine.h"
+#include "ssdk_flow_acl_owner.h"
+#include "ssdk_flow_napt.h"
+#include "ssdk_flow_profile.h"
+#include "ssdk_flow_gate.h"
+struct ssdk_flow_engine {
+	struct mutex lock;
+	unsigned int dev;
+	atomic_t generation;
+	unsigned int acknowledged;
+	bool gate_owned, active, suspended;
+	struct ssdk_edma_vlan_config vlans;
+	struct ssdk_flow_resolver resolver;
+	struct ssdk_flow_profile *profile;
+	struct ssdk_flow_acl_owner *acl;
+	struct ssdk_flow_host *hosts;
+	struct ssdk_flow_napt *napt;
+	struct ssdk_flow_hw *hw;
+	struct ssdk_flow_state *state;
+};
+void ssdk_flow_engine_invalidate(struct ssdk_flow_engine *engine)
+{
+	if (!engine) return;
+	atomic_inc(&engine->generation);
+	if (READ_ONCE(engine->gate_owned)) ssdk_flow_gate_invalidate(engine->dev);
+}
+/* The caller holds engine->lock; hardware removal does not acquire RTNL. */
+static int flush(struct ssdk_flow_engine *engine)
+{
+	unsigned int generation = atomic_read(&engine->generation);
+	u64 epoch;
+	int ret;
+	ret = ssdk_flow_gate_pause(engine->dev, &epoch);
+	if (ret) return ret;
+	ret = ssdk_flow_state_flush(engine->state);
+	if (ret) return ret;
+	ret = ssdk_flow_profile_prefix_reset(engine->profile);
+	if (ret) return ret;
+	ret = ssdk_flow_gate_ack(engine->dev, epoch);
+	if (ret) return ret;
+	/* An invalidation concurrent with cleanup must not be forgotten. */
+	if (generation != atomic_read(&engine->generation)) return -EAGAIN;
+	engine->acknowledged = generation;
+	return 0;
+}
+int ssdk_flow_engine_create(unsigned int dev, void __iomem *base, size_t size,
+	const struct ssdk_flow_resolver *resolver, struct ssdk_flow_engine **out)
+{
+	struct ssdk_flow_engine *engine;
+	int ret;
+	if (!out) return -EINVAL;
+	*out = NULL;
+	if (!resolver || !resolver->gmac[0] || !resolver->gmac[1] || !resolver->vlans)
+		return -EINVAL;
+	engine = kzalloc(sizeof(*engine), GFP_KERNEL);
+	if (!engine) return -ENOMEM;
+	mutex_init(&engine->lock); atomic_set(&engine->generation, 0);
+	engine->dev = dev; engine->resolver = *resolver; engine->resolver.dev = dev;
+	engine->vlans = *resolver->vlans; engine->resolver.vlans = &engine->vlans;
+	*out = engine;
+	ret = ssdk_flow_gate_claim(dev, base, size);
+	/* EIO can mean that claim's own restoration failed and ownership is
+	 * retained. EBUSY belongs to somebody else and must never be released. */
+	if (!ret || ret == -EIO) WRITE_ONCE(engine->gate_owned, true);
+	if (ret) return ret;
