+}
+int ssdk_flow_state_delete(struct ssdk_flow_state *state, unsigned long cookie)
+{
+	int found, ret = 0;
+	mutex_lock(&state->lock);
+	found = find_cookie(state, cookie);
+	if (found >= 0) {
+		struct ssdk_flow_entry *entry = &state->entries[found];
+		if (entry->slot >= 0) ret = remove_slot(state, entry->slot);
+		else drop_entry(entry);
+	}
+	mutex_unlock(&state->lock);
+	return ret;
+}
+int ssdk_flow_state_stats(struct ssdk_flow_state *state, unsigned long cookie,
+			  struct ssdk_flow_delta *delta)
+{
