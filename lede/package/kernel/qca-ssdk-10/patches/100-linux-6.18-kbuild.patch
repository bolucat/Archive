--- a/src/ref/ref_edma.c
+++ b/src/ref/ref_edma.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Synchronous VLAN configuration handoff between the DESS switch and EDMA. */
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include "ssdk_edma.h"
+
+static DEFINE_MUTEX(ssdk_edma_lock);
+static BLOCKING_NOTIFIER_HEAD(ssdk_edma_chain);
+static struct ssdk_edma_vlan_config *ssdk_edma_current;
+static struct ssdk_edma_vlan_config *ssdk_edma_pending;
+
+int ssdk_edma_register_notifier(struct notifier_block *nb)
+{
+	int ret;
+
+	mutex_lock(&ssdk_edma_lock);
+	ret = blocking_notifier_chain_register(&ssdk_edma_chain, nb);
+	if (!ret && ssdk_edma_current) {
+		ret = notifier_to_errno(nb->notifier_call(nb, SSDK_EDMA_PREPARE,
+							ssdk_edma_current));
+		if (ret) {
+			nb->notifier_call(nb, SSDK_EDMA_ABORT, NULL);
+			blocking_notifier_chain_unregister(&ssdk_edma_chain, nb);
+		} else {
+			nb->notifier_call(nb, SSDK_EDMA_COMMIT, ssdk_edma_current);
+		}
+	}
+	mutex_unlock(&ssdk_edma_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ssdk_edma_register_notifier);
+
+void ssdk_edma_unregister_notifier(struct notifier_block *nb)
+{
+	mutex_lock(&ssdk_edma_lock);
+	blocking_notifier_chain_unregister(&ssdk_edma_chain, nb);
+	mutex_unlock(&ssdk_edma_lock);
+}
+EXPORT_SYMBOL_GPL(ssdk_edma_unregister_notifier);
+
+int ssdk_edma_vlan_begin(const struct ssdk_edma_vlan_config *config)
+{
+	int ret;
+
+	mutex_lock(&ssdk_edma_lock);
+	ssdk_edma_pending = config ? kmemdup(config, sizeof(*config), GFP_KERNEL) :
+		kzalloc(sizeof(*ssdk_edma_pending), GFP_KERNEL);
+	if (!ssdk_edma_pending) {
+		mutex_unlock(&ssdk_edma_lock);
+		return -ENOMEM;
+	}
+	ret = notifier_to_errno(blocking_notifier_call_chain(&ssdk_edma_chain,
+					SSDK_EDMA_PREPARE, ssdk_edma_pending));
+	if (ret) {
+		blocking_notifier_call_chain(&ssdk_edma_chain, SSDK_EDMA_ABORT, NULL);
+		kfree(ssdk_edma_pending);
+		ssdk_edma_pending = NULL;
+		mutex_unlock(&ssdk_edma_lock);
+	}
+	/* On success, finish must run in this same task, including error exits. */
+	return ret;
+}
+
+void ssdk_edma_vlan_finish(bool success)
+{
+	if (!success) {
+		memset(ssdk_edma_pending->members, 0, sizeof(ssdk_edma_pending->members));
+		memset(ssdk_edma_pending->tagged, 0, sizeof(ssdk_edma_pending->tagged));
+	}
+	blocking_notifier_call_chain(&ssdk_edma_chain,
+			success ? SSDK_EDMA_COMMIT : SSDK_EDMA_FAILED, ssdk_edma_pending);
+	kfree(ssdk_edma_current);
+	ssdk_edma_current = ssdk_edma_pending;
+	ssdk_edma_pending = NULL;
+	mutex_unlock(&ssdk_edma_lock);
+}
+
+void ssdk_edma_cleanup(void)
+{
+	mutex_lock(&ssdk_edma_lock);
+	kfree(ssdk_edma_current);
+	ssdk_edma_current = NULL;
+	mutex_unlock(&ssdk_edma_lock);
+}
--- a/src/ref/ref_flow_acl.c
+++ b/src/ref/ref_flow_acl.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exact DESS permissions. These constructors never modify hardware. */
+#include <linux/etherdevice.h>
+#include <linux/in.h>
+#include "ssdk_flow_acl.h"
+
+static void ssdk_flow_router(fal_acl_rule_t *acl, const u8 router[ETH_ALEN])
+{
+	FAL_FIELD_FLG_SET(acl->field_flg, FAL_ACL_FIELD_MAC_DA);
+	memcpy(acl->dest_mac_val.uc, router, ETH_ALEN);
+	memset(acl->dest_mac_mask.uc, 0xff, ETH_ALEN);
+}
+
+int ssdk_flow_acl(const struct ssdk_flow_rule *rule, const u8 router[ETH_ALEN],
+		 u16 vid, u16 arp, bool outbound, fal_acl_rule_t *result)
+{
+	fal_acl_rule_t acl = {};
+
+	/* ARP_PTR is only seven bits in DESS ACL actions. Never truncate a
+	 * host-table handle into an unrelated neighbour entry. */
+	if (!rule || !router || !result || !is_valid_ether_addr(router) ||
+	    !vid || vid >= 4095 || arp >= 128 ||
+	    (rule->protocol != IPPROTO_TCP && rule->protocol != IPPROTO_UDP))
+		return -EOPNOTSUPP;
+	acl.rule_type = FAL_ACL_RULE_IP4;
+	ssdk_flow_router(&acl, router);
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_MAC_VID);
+	acl.vid_val = vid; acl.vid_mask = 4095; acl.vid_op = FAL_ACL_FIELD_MASK;
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_IP4_SIP);
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_IP4_DIP);
+	acl.src_ip4_val = ntohl(rule->match.src);
+	acl.dest_ip4_val = ntohl(rule->match.dst);
+	acl.src_ip4_mask = acl.dest_ip4_mask = ~0U;
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_IP_PROTO);
+	acl.ip_proto_val = rule->protocol; acl.ip_proto_mask = 0xff;
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_L4_SPORT);
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_L4_DPORT);
+	acl.src_l4port_val = ntohs(rule->match.sport);
+	acl.dest_l4port_val = ntohs(rule->match.dport);
+	acl.src_l4port_mask = acl.dest_l4port_mask = 0xffff;
+	acl.src_l4port_op = acl.dest_l4port_op = FAL_ACL_FIELD_MASK;
+	if (rule->protocol == IPPROTO_TCP) {
+		FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_TCP_FLAG);
+		acl.tcp_flag_mask = 7; /* FIN/SYN/RST always go to CPU. */
+	}
+	FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_UDF);
+	acl.udf_len = SSDK_FLOW_UDF_L3_LENGTH + SSDK_FLOW_UDF_L4_LENGTH;
+	/* No IP options, reserved fragment flag, MF or fragment offset. DF
+	 * may be set. DESS ignores the generic FAL fragment match flags. */
+	acl.udf_val[0] = 0x45; acl.udf_mask[0] = 0xff;
+	acl.udf_mask[6] = 0xbf; acl.udf_mask[7] = 0xff;
+	FAL_ACTION_FLG_SET(acl.action_flg, FAL_ACL_ACTION_ARP_EN);
+	FAL_ACTION_FLG_SET(acl.action_flg, FAL_ACL_ACTION_POLICY_FORWARD_EN);
+	acl.arp_ptr = arp;
+	acl.policy_fwd = outbound ? FAL_ACL_POLICY_SNAT : FAL_ACL_POLICY_DNAT;
+	*result = acl;
+	return 0;
+}
+
+int ssdk_flow_trap(const u8 router[ETH_ALEN], enum ssdk_flow_exception exception,
+		  fal_acl_rule_t *result)
+{
+	fal_acl_rule_t acl = {};
+
+	if (!router || !result || !is_valid_ether_addr(router) ||
+	    exception < SSDK_FLOW_TRAP_ALL || exception > SSDK_FLOW_TRAP_UDP_ZERO)
+		return -EOPNOTSUPP;
+	acl.rule_type = FAL_ACL_RULE_MAC;
+	ssdk_flow_router(&acl, router);
+	FAL_ACTION_FLG_SET(acl.action_flg, FAL_ACL_ACTION_RDTCPU);
+	if (exception != SSDK_FLOW_TRAP_ALL) {
+		acl.rule_type = FAL_ACL_RULE_IP4;
+		FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_UDF);
+		acl.udf_len = SSDK_FLOW_UDF_L3_LENGTH + SSDK_FLOW_UDF_L4_LENGTH;
+		if (exception == SSDK_FLOW_TRAP_TTL) {
+			/* Matches TTL 0 and 1 before any per-connection permission. */
+			acl.udf_mask[8] = 0xfe;
+		} else {
+			FAL_FIELD_FLG_SET(acl.field_flg, FAL_ACL_FIELD_IP_PROTO);
+			acl.ip_proto_val = IPPROTO_UDP; acl.ip_proto_mask = 0xff;
+			/* DESS's zero UDP checksum path needs special handling. The
+			 * 16-byte key fits only its high byte: trap the superset with
+			 * high byte zero, including all checksum-disabled datagrams. */
+			acl.udf_mask[15] = 0xff;
+		}
+	}
+	*result = acl;
+	return 0;
+}
--- a/src/ref/ref_flow_acl_owner.c
+++ b/src/ref/ref_flow_acl_owner.c
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/etherdevice.h>
+#include <linux/slab.h>
+#include "dess_acl.h"
+#include "ssdk_flow_acl_owner.h"
+#include "ssdk_flow_state.h"
+#define FLOW_GUARDS 8
+#define GUARD_LIST_BASE 128
+#define PERMISSION_LIST_BASE 160
+#define EXTERNAL_PORTS 0x3e
+struct owned_list {
+	unsigned int id, rules;
+	bool created, bind_attempted;
+};
+struct owned_guard {
+	bool used, ready;
+	unsigned int refs;
+	u8 mac[ETH_ALEN];
+	struct owned_list fallback, exceptions;
+};
+struct owned_permission {
+	bool used;
+	int guard[2];
+	struct owned_list lists[2];
+};
+struct ssdk_flow_acl_owner {
+	unsigned int dev;
+	struct owned_guard guards[FLOW_GUARDS];
+	struct owned_permission permissions[SSDK_FLOW_COUNTERS];
+};
+static int recover(struct ssdk_flow_acl_owner *owner)
+{
+	return dess_acl_recover(owner->dev) == SW_OK ? 0 : -EIO;
+}
+static int owned_list_add(struct ssdk_flow_acl_owner *owner, struct owned_list *list,
+		    unsigned int id, unsigned int priority, fal_acl_rule_t *rules,
+		    unsigned int count, unsigned int ports)
+{
+	sw_error_t rv;
+	list->id = id;
+	rv = fal_acl_list_creat(owner->dev, id, priority);
+	if (rv != SW_OK) return rv == SW_ALREADY_EXIST ? -EEXIST : -EIO;
+	list->created = true;
+	rv = fal_acl_rule_add(owner->dev, id, 0, count, rules);
+	if (rv != SW_OK) return -EIO;
+	list->rules = count;
+	list->bind_attempted = true;
+	return fal_acl_list_bind(owner->dev, id, FAL_ACL_DIREC_IN,
+				FAL_ACL_BIND_PORTBITMAP, ports) == SW_OK ? 0 : -EIO;
+}
+static int owned_list_remove(struct ssdk_flow_acl_owner *owner, struct owned_list *list)
+{
+	sw_error_t rv;
+	if (!list->created) return 0;
+	if (list->bind_attempted) {
+		if (fal_acl_list_unbind(owner->dev, list->id, FAL_ACL_DIREC_IN,
+				       FAL_ACL_BIND_PORTBITMAP, EXTERNAL_PORTS) != SW_OK) return -EIO;
+		list->bind_attempted = false;
+	}
+	if (list->rules) {
+		if (fal_acl_rule_delete(owner->dev, list->id, 0, list->rules) != SW_OK) return -EIO;
+		list->rules = 0;
+	}
+	rv = fal_acl_list_destroy(owner->dev, list->id);
+	if (rv != SW_OK && rv != SW_NOT_FOUND) return -EIO;
+	memset(list, 0, sizeof(*list)); return 0;
+}
+struct ssdk_flow_acl_owner *ssdk_flow_acl_owner_create(unsigned int dev)
+{
+	struct ssdk_flow_acl_owner *owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	if (owner) owner->dev = dev;
+	return owner;
+}
+int ssdk_flow_guard_get(struct ssdk_flow_acl_owner *owner, const u8 *mac, int *handle)
+{
+	struct owned_guard *guard;
+	fal_acl_rule_t rules[2];
+	int i, free = -1, ret;
+	if (!handle) return -EINVAL;
+	*handle = -1;
+	if (!mac || !is_valid_ether_addr(mac)) return -EINVAL;
+	if (recover(owner)) return -EIO;
+	for (i = 0; i < FLOW_GUARDS; i++) {
+		guard = &owner->guards[i];
+		if (!guard->used) { if (free < 0) free = i; continue; }
+		if (!guard->ready) return -EIO;
+		if (ether_addr_equal(mac, guard->mac)) {
+			guard->refs++; *handle = i; return 0;
+		}
+	}
+	if (free < 0) return -ENOSPC;
+	guard = &owner->guards[free];
+	guard->used = true; guard->refs = 1; ether_addr_copy(guard->mac, mac);
+	*handle = free;
+	ret = ssdk_flow_trap(mac, SSDK_FLOW_TRAP_ALL, &rules[0]);
+	if (ret) return ret;
+	/* Install the fallback guard before the higher-priority exceptions. */
+	ret = owned_list_add(owner, &guard->fallback, GUARD_LIST_BASE + 2*free + 1,
+		       SSDK_FLOW_ACL_GUARD_PRIORITY, rules, 1, EXTERNAL_PORTS);
+	if (ret) return ret;
+	ret = ssdk_flow_trap(mac, SSDK_FLOW_TRAP_TTL, &rules[0]);
+	if (ret) return ret;
+	ret = ssdk_flow_trap(mac, SSDK_FLOW_TRAP_UDP_ZERO, &rules[1]);
+	if (ret) return ret;
+	ret = owned_list_add(owner, &guard->exceptions, GUARD_LIST_BASE + 2*free,
+		       SSDK_FLOW_ACL_EXCEPTION_PRIORITY, rules, 2, EXTERNAL_PORTS);
+	if (!ret) guard->ready = true;
+	return ret;
+}
+int ssdk_flow_guard_put(struct ssdk_flow_acl_owner *owner, int handle)
+{
+	struct owned_guard *guard;
+	unsigned int i;
+	int ret;
+	if (handle < 0 || handle >= FLOW_GUARDS) return -EINVAL;
+	guard = &owner->guards[handle];
+	if (!guard->used) return 0;
+	if (guard->refs > 1) { guard->refs--; return 0; }
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (owner->permissions[i].used &&
+		    (owner->permissions[i].guard[0] == handle || owner->permissions[i].guard[1] == handle))
+			return -EBUSY;
+	if (recover(owner)) return -EIO;
+	guard->ready = false;
+	ret = owned_list_remove(owner, &guard->exceptions);
+	if (ret) return ret;
+	ret = owned_list_remove(owner, &guard->fallback);
+	if (ret) return ret;
+	memset(guard, 0, sizeof(*guard)); return 0;
+}
+int ssdk_flow_permission_add(struct ssdk_flow_acl_owner *owner, unsigned int slot,
+			    const struct ssdk_flow_rule rules[2],
+			    const struct ssdk_flow_acl_path paths[2], unsigned int outbound)
+{
+	struct owned_permission *permission;
+	fal_acl_rule_t acl;
+	unsigned int i;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS || !rules || !paths || outbound > 1) return -EINVAL;
+	if (recover(owner)) return -EIO;
+	permission = &owner->permissions[slot];
+	if (permission->used) return -EBUSY;
+	for (i = 0; i < 2; i++) {
+		if (paths[i].guard < 0 || paths[i].guard >= FLOW_GUARDS ||
+		    !owner->guards[paths[i].guard].ready || !paths[i].port || paths[i].port > 5)
+			return -EINVAL;
+	}
+	permission->used = true;
+	permission->guard[0] = paths[0].guard; permission->guard[1] = paths[1].guard;
+	for (i = 0; i < 2; i++) {
+		ret = ssdk_flow_acl(&rules[i], owner->guards[paths[i].guard].mac,
+				    paths[i].vid, paths[i].arp, i == outbound, &acl);
+		if (ret) return ret;
+		ret = owned_list_add(owner, &permission->lists[i], PERMISSION_LIST_BASE + 2*slot + i,
+			       SSDK_FLOW_ACL_PERMIT_PRIORITY, &acl, 1, BIT(paths[i].port));
+		if (ret) return ret;
+	}
+	return 0;
+}
+int ssdk_flow_permission_remove(struct ssdk_flow_acl_owner *owner, unsigned int slot)
+{
+	struct owned_permission *permission;
+	unsigned int i;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS) return -EINVAL;
+	permission = &owner->permissions[slot];
+	if (!permission->used) return 0;
+	if (recover(owner)) return -EIO;
+	for (i = 0; i < 2; i++) {
+		ret = owned_list_remove(owner, &permission->lists[i]);
+		if (ret) return ret;
+	}
+	memset(permission, 0, sizeof(*permission)); return 0;
+}
+int ssdk_flow_acl_owner_destroy(struct ssdk_flow_acl_owner *owner)
+{
+	unsigned int i;
+	int ret = 0;
+	if (!owner) return 0;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (ssdk_flow_permission_remove(owner, i)) ret = -EIO;
+	for (i = 0; i < FLOW_GUARDS; i++) {
+		if (!owner->guards[i].used) continue;
+		owner->guards[i].refs = 1;
+		if (ssdk_flow_guard_put(owner, i)) ret = -EIO;
+	}
+	if (!ret) kfree(owner);
+	return ret;
+}
