+	mod_delayed_work(system_wq, &collector, HZ);
+	return 0;
+}
+int ssdk_flow_user_begin(bool reconfigure)
+{
+	int ret = 0;
+	if (reconfigure) {
+		mutex_lock(&control_lock);
+		ret = stop_engine();
+		if (!ret) down_read(&user_access);
+		mutex_unlock(&control_lock);
+		return ret;
+	}
+	down_read(&user_access);
+	if (native_owned) { up_read(&user_access); return -EBUSY; }
+	return 0;
+}
+void ssdk_flow_user_end(void) { up_read(&user_access); }
+static void collect_work(struct work_struct *work)
+{
+	mutex_lock(&control_lock);
+	if (engine) {
+		if (closing || !attached || !bound_block) stop_engine();
+		else ssdk_flow_engine_collect(engine);
+		if (engine) mod_delayed_work(system_wq, &collector, HZ);
+	}
+	release_devices();
+	mutex_unlock(&control_lock);
+}
+static void invalidate(void)
+{
+	struct ssdk_flow_engine *observed;
+	rcu_read_lock();
+	observed = rcu_dereference(notifier_engine);
+	if (observed) ssdk_flow_engine_invalidate(observed);
+	rcu_read_unlock();
+	/* The periodic collector already owns a module reference. Do not
+	 * schedule new work from a notifier after the last engine is gone. */
+}
+static int netdevice_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	if (!net_eq(dev_net(dev), &init_net)) return NOTIFY_DONE;
+	switch (event) {
+	case NETDEV_UP: case NETDEV_DOWN: case NETDEV_CHANGE: case NETDEV_UNREGISTER:
+	case NETDEV_CHANGEADDR: case NETDEV_CHANGEMTU: case NETDEV_CHANGEUPPER:
+	case NETDEV_PRECHANGEUPPER: case NETDEV_CHANGELOWERSTATE: case NETDEV_FEAT_CHANGE:
+		invalidate(); break;
+	}
+	return NOTIFY_DONE;
+}
+static int route_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{ invalidate(); return NOTIFY_DONE; }
+static int neighbour_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	if (event == NETEVENT_NEIGH_UPDATE || event == NETEVENT_REDIRECT) invalidate();
+	return NOTIFY_DONE;
+}
+static int bridge_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	if (event == SWITCHDEV_FDB_ADD_TO_DEVICE || event == SWITCHDEV_FDB_DEL_TO_DEVICE)
+		invalidate();
+	return NOTIFY_DONE;
+}
+static int vlan_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	int ret = 0;
+	mutex_lock(&control_lock);
+	switch (event) {
+	case SSDK_EDMA_PREPARE:
+		changing = true;
+		if (engine && !closing) ret = ssdk_flow_engine_vlan_begin(engine);
+		if (closing) ret = -EBUSY;
+		break;
+	case SSDK_EDMA_COMMIT: case SSDK_EDMA_FAILED:
+		if (ptr) vlan_map = *(struct ssdk_edma_vlan_config *)ptr;
+		else memset(&vlan_map, 0, sizeof(vlan_map));
+		if (engine && !closing) ssdk_flow_engine_vlan_end(engine, &vlan_map);
+		changing = false; break;
+	case SSDK_EDMA_ABORT:
+		if (engine && !closing) ssdk_flow_engine_vlan_end(engine, NULL);
+		changing = false; break;
+	}
+	mutex_unlock(&control_lock);
+	return notifier_from_errno(ret);
+}
+static struct notifier_block netdevice_nb = { .notifier_call = netdevice_event };
+static struct notifier_block route_nb = { .notifier_call = route_event };
+static struct notifier_block address_nb = { .notifier_call = route_event };
+static struct notifier_block neighbour_nb = { .notifier_call = neighbour_event };
+static struct notifier_block bridge_nb = { .notifier_call = bridge_event };
+static struct notifier_block vlan_nb = { .notifier_call = vlan_event, .priority = 10 };
+int ssdk_flow_attach(struct net_device *wan, struct net_device *lan)
+{
+	int ret;
+	if (!wan || !lan || wan == lan || !net_eq(dev_net(wan), &init_net) ||
+	    !net_eq(dev_net(lan), &init_net)) return -EINVAL;
+	if (SSDK_CURRENT_CHIP_TYPE != CHIP_DESS || !qca_phy_priv_global ||
+	    !qca_phy_priv_global[0] || !qca_phy_priv_global[0]->hw_addr ||
+	    ssdk_switch_reg_access_mode_get(0) != HSL_REG_LOCAL_BUS) return -EOPNOTSUPP;
+	mutex_lock(&control_lock);
+	if (attached || initializing || gmac[0]) { mutex_unlock(&control_lock); return -EBUSY; }
+	initializing = true; gmac[0] = wan; gmac[1] = lan; dev_hold(wan); dev_hold(lan);
+	mutex_unlock(&control_lock);
+	ret = ssdk_edma_register_notifier(&vlan_nb); if (ret) goto fail;
+	ret = register_netdevice_notifier(&netdevice_nb); if (ret) goto vlan;
+	ret = register_inetaddr_notifier(&address_nb); if (ret) goto netdev;
+	ret = register_netevent_notifier(&neighbour_nb); if (ret) goto address;
+	ret = register_switchdev_notifier(&bridge_nb); if (ret) goto neighbour;
+	ret = register_fib_notifier(&init_net, &route_nb, NULL, NULL); if (ret) goto bridge;
+	mutex_lock(&control_lock); initializing = false; attached = true; mutex_unlock(&control_lock);
+	return 0;
+bridge:
+	unregister_switchdev_notifier(&bridge_nb);
+neighbour:
+	unregister_netevent_notifier(&neighbour_nb);
+address:
+	unregister_inetaddr_notifier(&address_nb);
+netdev:
+	unregister_netdevice_notifier(&netdevice_nb);
+vlan:
+	ssdk_edma_unregister_notifier(&vlan_nb);
+fail:
+	mutex_lock(&control_lock); initializing = false; release_devices(); mutex_unlock(&control_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ssdk_flow_attach);
+void ssdk_flow_detach(void)
+{
+	mutex_lock(&control_lock);
+	if (!attached) { mutex_unlock(&control_lock); return; }
+	attached = false;
+	stop_engine();
+	mutex_unlock(&control_lock);
+	unregister_fib_notifier(&init_net, &route_nb);
+	unregister_switchdev_notifier(&bridge_nb);
+	unregister_netevent_notifier(&neighbour_nb);
+	unregister_inetaddr_notifier(&address_nb);
+	unregister_netdevice_notifier(&netdevice_nb);
+	ssdk_edma_unregister_notifier(&vlan_nb);
+	cancel_delayed_work_sync(&collector);
+	mutex_lock(&control_lock);
+	if (engine) mod_delayed_work(system_wq, &collector, HZ);
+	release_devices(); mutex_unlock(&control_lock);
+}
+EXPORT_SYMBOL_GPL(ssdk_flow_detach);
+void ssdk_flow_control_cleanup(void)
+{
+	ssdk_flow_detach();
+	cancel_delayed_work_sync(&collector);
+	WARN_ON(engine || bound_block);
+}
+static int block_command(enum tc_setup_type type, void *data, void *priv)
+{
+	struct flow_cls_offload *flow = data;
+	int ret = -EOPNOTSUPP;
+	if (type != TC_SETUP_CLSFLOWER) return ret;
+	mutex_lock(&control_lock);
+	if (!attached || changing || !bound_block || closing) goto out;
+	if (!(gmac[0]->features & NETIF_F_HW_TC) || !(gmac[1]->features & NETIF_F_HW_TC)) {
+		stop_engine(); goto out;
+	}
+	if (!engine && flow->command == FLOW_CLS_REPLACE) {
+		ret = start_engine(); if (ret) goto out;
+	}
+	if (!engine) { ret = flow->command == FLOW_CLS_DESTROY ? 0 : -ENOENT; goto out; }
+	ret = ssdk_flow_engine_command(engine, flow);
+out:
+	mutex_unlock(&control_lock); return ret;
+}
+static void block_release(void *priv) { module_put(THIS_MODULE); }
+int ssdk_flow_setup_tc(struct net_device *dev, enum tc_setup_type type, void *data)
+{
+	struct flow_block_offload *offload = data;
+	struct flow_block_cb *cb;
+	int ret = -EOPNOTSUPP;
+	if (type != TC_SETUP_FT || !offload || offload->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return ret;
+	mutex_lock(&control_lock);
+	if (dev != gmac[0] && dev != gmac[1]) goto out;
+	offload->driver_block_list = &driver_blocks;
+	if (offload->command == FLOW_BLOCK_BIND) {
+		if (!attached) { ret = -EAGAIN; goto out; }
+		if (!tc_can_offload(dev)) goto out;
+		if (bound_block && bound_block != offload->block) { ret = -EBUSY; goto out; }
+		cb = flow_block_cb_lookup(offload->block, block_command, &control_lock);
+		if (cb) { flow_block_cb_incref(cb); ret = 0; goto out; }
+		/* Binding a flowtable must not depend on a configured switch or
+		 * free hardware tables. Claim the engine on the first REPLACE;
+		 * unavailable hardware then falls back per flow, not per firewall. */
+		if (!try_module_get(THIS_MODULE)) { ret = -ENODEV; goto out; }
+		cb = flow_block_cb_alloc(block_command, &control_lock, NULL, block_release);
+		if (IS_ERR(cb)) { ret = PTR_ERR(cb); module_put(THIS_MODULE); goto out; }
+		flow_block_cb_incref(cb); flow_block_cb_add(cb, offload);
+		list_add_tail(&cb->driver_list, &driver_blocks); bound_block = offload->block; ret = 0;
+	} else if (offload->command == FLOW_BLOCK_UNBIND) {
+		cb = flow_block_cb_lookup(offload->block, block_command, &control_lock);
+		if (!cb) { ret = -ENOENT; goto out; }
+		if (!flow_block_cb_decref(cb)) {
+			flow_block_cb_remove(cb, offload); list_del(&cb->driver_list);
+			bound_block = NULL; stop_engine(); release_devices();
+		}
+		ret = 0;
+	}
+out:
+	mutex_unlock(&control_lock); return ret;
+}
+EXPORT_SYMBOL_GPL(ssdk_flow_setup_tc);
