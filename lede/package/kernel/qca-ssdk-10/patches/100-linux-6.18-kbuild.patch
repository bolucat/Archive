+++ b/include/ref/ssdk_flow_state.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_STATE_H
+#define _SSDK_FLOW_STATE_H
+#include "ssdk_flow.h"
+#define SSDK_FLOW_COUNTERS 8
+#define SSDK_FLOW_PENDING 32
+struct ssdk_flow_state;
+struct ssdk_flow_counts { u32 packets[2], bytes[2]; };
+struct ssdk_flow_delta { u64 packets, bytes; };
+/* Operations run serialized in process context. Each slot owns an exclusive
+ * hardware counter. install must capture its baseline before enabling ACL
+ * permissions. remove must handle partial installs and revoke permissions
+ * before releasing dependent resources. Failed removal retains the slot and
+ * freezes new installs; the backend must also stop unsafe hardware forwarding.
+ * Counter direction 0 is canonical outbound, direction 1 is inbound. */
+struct ssdk_flow_ops {
+	int (*install)(void *ctx, unsigned int slot, const struct ssdk_flow_rule rules[2],
+		       const struct ssdk_flow_pair *pair, struct ssdk_flow_counts *baseline);
+	int (*remove)(void *ctx, unsigned int slot);
+	int (*read)(void *ctx, unsigned int slot, struct ssdk_flow_counts *counts);
+};
+struct ssdk_flow_state *ssdk_flow_state_create(const struct ssdk_flow_ops *ops, void *ctx);
+int ssdk_flow_state_replace(struct ssdk_flow_state *state, unsigned long cookie,
+			    const struct ssdk_flow_rule *rule, unsigned long now);
+int ssdk_flow_state_delete(struct ssdk_flow_state *state, unsigned long cookie);
+int ssdk_flow_state_stats(struct ssdk_flow_state *state, unsigned long cookie,
+			  struct ssdk_flow_delta *delta);
+int ssdk_flow_state_gc(struct ssdk_flow_state *state, unsigned long now);
+/* Flush both pending and installed flows after invalidation. Failed removals
+ * retain their refs for retry. The caller must prevent new replace callbacks
+ * until configuration has been revalidated and the gate acknowledged. */
+int ssdk_flow_state_flush(struct ssdk_flow_state *state);
+/* Caller must quiesce callbacks before destruction. Close to new work and
+ * free only after all hardware resources are released.
+ * On error the object remains valid for retry; the caller must retain it. */
+int ssdk_flow_state_destroy(struct ssdk_flow_state *state);
+#endif
