--- a/include/ref/ssdk_edma.h
+++ b/include/ref/ssdk_edma.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_EDMA_H
+#define _SSDK_EDMA_H
+#include <linux/types.h>
+#include <linux/notifier.h>
+
+#define SSDK_EDMA_VIDS 4096
+/* Native switch ports: bit 0 is the CPU, bits 1..5 are external ports. */
+struct ssdk_edma_vlan_config {
+	u16 default_vid[2]; /* EDMA GMAC0/WAN, GMAC1/LAN */
+	u8 members[SSDK_EDMA_VIDS];
+	u8 tagged[SSDK_EDMA_VIDS];
+};
+enum ssdk_edma_vlan_event {
+	SSDK_EDMA_PREPARE = 1,
+	SSDK_EDMA_COMMIT,
+	SSDK_EDMA_ABORT,
+	SSDK_EDMA_FAILED,
+};
+/* Callbacks run synchronously in process context. PREPARE may allocate and
+ * reject the update. Other events must not fail. FAILED requires dropping
+ * traffic, because hardware may contain a partially programmed table.
+ * Callbacks must not reenter these APIs or take the swconfig reg_mutex. */
+int ssdk_edma_register_notifier(struct notifier_block *nb);
+void ssdk_edma_unregister_notifier(struct notifier_block *nb);
+int ssdk_edma_vlan_begin(const struct ssdk_edma_vlan_config *config);
+void ssdk_edma_vlan_finish(bool success);
+void ssdk_edma_cleanup(void);
+#endif
--- a/include/ref/ssdk_flow.h
+++ b/include/ref/ssdk_flow.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_H
+#define _SSDK_FLOW_H
+#include <linux/types.h>
+#include <linux/if_ether.h>
+struct flow_rule;
+struct net_device;
+struct ssdk_flow_tuple {
+	__be32 src, dst;
+	__be16 sport, dport;
+};
+struct ssdk_flow_rule {
+	struct ssdk_flow_tuple match, translated;
+	int ingress_ifindex;
+	/* Borrowed for the duration of the callback; the owner must take a
+	 * netdev reference before retaining a parsed rule asynchronously. */
+	struct net_device *egress;
+	u8 protocol;
+	u8 tcp_mask;
+	u8 destination[ETH_ALEN], source[ETH_ALEN];
+	u16 ingress_vid, egress_vid;
+	bool vlan_match, vlan_pop, vlan_push;
+};
+/* One DESS NAPT record owns both Linux direction cookies. */
+struct ssdk_flow_pair {
+	struct ssdk_flow_tuple outbound, translated;
+	u8 protocol, outbound_direction;
+};
+int ssdk_flow_pair(const struct ssdk_flow_rule rules[2], struct ssdk_flow_pair *result);
+int ssdk_flow_parse(const struct flow_rule *rule, struct ssdk_flow_rule *result);
+#endif
--- a/include/ref/ssdk_flow_acl.h
+++ b/include/ref/ssdk_flow_acl.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_ACL_H
+#define _SSDK_FLOW_ACL_H
+#include "sw.h"
+#include "fal_acl.h"
+#include "ssdk_flow.h"
+/* DESS concatenates extraction windows. All other windows must have length 0.
+ * L3 bytes 0..8 followed by L4 bytes 0..6 give a 16-byte UDF key. */
+#define SSDK_FLOW_UDF_L3_LENGTH 9
+#define SSDK_FLOW_UDF_L4_LENGTH 7
+/* Smaller list priority wins. Exceptions precede permissions and the guard. */
+#define SSDK_FLOW_ACL_EXCEPTION_PRIORITY 10
+#define SSDK_FLOW_ACL_PERMIT_PRIORITY 20
+#define SSDK_FLOW_ACL_GUARD_PRIORITY 30
+enum ssdk_flow_exception {
+	SSDK_FLOW_TRAP_ALL,
+	SSDK_FLOW_TRAP_TTL,
+	SSDK_FLOW_TRAP_UDP_ZERO,
+};
+int ssdk_flow_acl(const struct ssdk_flow_rule *rule, const u8 router[ETH_ALEN],
+		 u16 vid, u16 arp, bool outbound, fal_acl_rule_t *result);
+int ssdk_flow_trap(const u8 router[ETH_ALEN], enum ssdk_flow_exception exception,
+		  fal_acl_rule_t *result);
+#endif
