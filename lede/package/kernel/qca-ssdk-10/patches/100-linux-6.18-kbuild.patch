+static int collect(struct ssdk_flow_state *state, unsigned long now)
+{
+	unsigned int i;
+	int ret = 0;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (state->slots[i].used && state->slots[i].quarantine && remove_slot(state, i))
+			ret = -EIO;
+	for (i = 0; i < FLOW_ENTRIES; i++)
+		if (state->entries[i].used && state->entries[i].slot < 0 &&
+		    time_after_eq(now, state->entries[i].expires))
+			drop_entry(&state->entries[i]);
+	return ret;
