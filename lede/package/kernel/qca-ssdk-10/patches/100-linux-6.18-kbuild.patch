+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SSDK_FLOW_PROFILE_H
+#define _SSDK_FLOW_PROFILE_H
+#include <linux/types.h>
+struct ssdk_flow_profile;
+/* Caller serializes access, excludes other writers. create audits both the
+ * software ACL shadow and hardware filters without changing either. Gate must remain paused throughout apply/restore.
+ * No resource may exist before apply or remain when restore is called.
+ * create only snapshots; apply failure retains a handle for restoration.
+ * restore deliberately leaves ACL enabled: release the gate after restore,
+ * then destroy restores the original ACL enable bit. Failed operations retain
+ * ownership and must be retried. No function enables L3/NAT forwarding. */
+struct ssdk_flow_profile *ssdk_flow_profile_create(unsigned int dev);
+int ssdk_flow_profile_apply(struct ssdk_flow_profile *profile);
+/* Resolver callback: lock one connected LAN prefix for the active flow set.
+ * Gate must be paused. Reset only after every owned flow has been removed. */
+int ssdk_flow_profile_prefix(void *ctx, __be32 base, __be32 mask);
+int ssdk_flow_profile_prefix_reset(struct ssdk_flow_profile *profile);
+int ssdk_flow_profile_restore(struct ssdk_flow_profile *profile);
+int ssdk_flow_profile_destroy(struct ssdk_flow_profile *profile);
+#endif
