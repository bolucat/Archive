+	if (IS_ERR(engine->profile)) {
+		ret = PTR_ERR(engine->profile); engine->profile = NULL; return ret;
+	}
+	ret = ssdk_flow_profile_apply(engine->profile);
+	if (ret) return ret;
+	engine->resolver.prefix = ssdk_flow_profile_prefix;
+	engine->resolver.ctx = engine->profile;
+	engine->acl = ssdk_flow_acl_owner_create(dev);
+	if (!engine->acl) return -ENOMEM;
+	engine->hosts = ssdk_flow_host_create(dev);
+	if (IS_ERR(engine->hosts)) {
+		ret = PTR_ERR(engine->hosts); engine->hosts = NULL; return ret;
+	}
+	engine->napt = ssdk_flow_napt_create(dev);
+	if (IS_ERR(engine->napt)) {
+		ret = PTR_ERR(engine->napt); engine->napt = NULL; return ret;
+	}
+	engine->hw = ssdk_flow_hw_create(dev, engine->acl, engine->hosts, engine->napt,
+				       ssdk_flow_resolve_paths, &engine->resolver);
+	if (!engine->hw) return -ENOMEM;
+	engine->state = ssdk_flow_state_create(&ssdk_flow_hw_ops, engine->hw);
+	if (!engine->state) return -ENOMEM;
+	engine->active = true;
+	return 0;
+}
+static void check_gate(struct ssdk_flow_engine *engine)
+{
+	/* The hardware transaction can invalidate on a resolver EAGAIN too;
+	 * distinguish that from state.replace's harmless unpaired EAGAIN. */
+	if (!ssdk_flow_gate_valid(engine->dev)) ssdk_flow_engine_invalidate(engine);
+}
+int ssdk_flow_engine_command(struct ssdk_flow_engine *engine, struct flow_cls_offload *flow)
+{
+	struct ssdk_flow_rule rule;
+	struct ssdk_flow_delta delta;
+	bool rtnl = false;
+	int ret = -ESHUTDOWN;
+	if (!engine || !flow || flow->common.chain_index) return -EOPNOTSUPP;
+	if (flow->command == FLOW_CLS_REPLACE) {
+		ret = ssdk_flow_parse(flow_cls_offload_flow_rule(flow), &rule);
+		if (ret) return ret;
+		if (!rtnl_trylock()) return -EAGAIN;
+		rtnl = true;
+	}
+	mutex_lock(&engine->lock);
+	ret = -ESHUTDOWN;
+	if (!engine->active) goto out;
+	if (engine->suspended && flow->command != FLOW_CLS_DESTROY) { ret = -EAGAIN; goto out; }
+	switch (flow->command) {
+	case FLOW_CLS_REPLACE:
+		if (engine->acknowledged != atomic_read(&engine->generation)) {
+			ret = flush(engine);
+			if (ret) break;
+		}
+		ret = ssdk_flow_state_replace(engine->state, flow->cookie, &rule, jiffies);
+		break;
+	case FLOW_CLS_DESTROY:
+		ret = ssdk_flow_state_delete(engine->state, flow->cookie);
+		break;
+	case FLOW_CLS_STATS:
+		if (engine->acknowledged != atomic_read(&engine->generation)) { ret = -EAGAIN; break; }
+		ret = ssdk_flow_state_stats(engine->state, flow->cookie, &delta);
+		if (!ret) flow_stats_update(&flow->stats, delta.bytes, delta.packets, 0,
+					   delta.packets ? jiffies : 0, FLOW_ACTION_HW_STATS_DELAYED);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+	}
+	check_gate(engine);
+out:
+	mutex_unlock(&engine->lock);
+	if (rtnl) rtnl_unlock();
+	return ret;
+}
+int ssdk_flow_engine_collect(struct ssdk_flow_engine *engine)
+{
+	int ret = -ESHUTDOWN;
+	if (!engine) return ret;
+	mutex_lock(&engine->lock);
+	if (engine->active) {
+		if (engine->acknowledged != atomic_read(&engine->generation)) ret = flush(engine);
+		else ret = ssdk_flow_state_gc(engine->state, jiffies);
+		check_gate(engine);
+	}
+	mutex_unlock(&engine->lock); return ret;
+}
+int ssdk_flow_engine_flush(struct ssdk_flow_engine *engine)
+{
+	int ret = -ESHUTDOWN;
+	if (!engine) return ret;
+	ssdk_flow_engine_invalidate(engine);
+	mutex_lock(&engine->lock);
+	if (engine->active) ret = flush(engine);
+	mutex_unlock(&engine->lock); return ret;
+}
+int ssdk_flow_engine_vlan_begin(struct ssdk_flow_engine *engine)
+{
+	int ret = -ESHUTDOWN;
+	if (!engine) return ret;
+	ssdk_flow_engine_invalidate(engine);
+	mutex_lock(&engine->lock);
+	engine->suspended = true;
+	if (engine->active) ret = flush(engine);
+	mutex_unlock(&engine->lock); return ret;
+}
+void ssdk_flow_engine_vlan_end(struct ssdk_flow_engine *engine,
+			      const struct ssdk_edma_vlan_config *config)
+{
+	if (!engine) return;
+	mutex_lock(&engine->lock);
+	if (config) engine->vlans = *config;
+	engine->suspended = false;
+	mutex_unlock(&engine->lock);
+}
+int ssdk_flow_engine_destroy(struct ssdk_flow_engine *engine)
+{
+	int ret = 0;
+	if (!engine) return 0;
+	/* The outer owner quiesces every callback before entering here. */
+	mutex_lock(&engine->lock); engine->active = false;
+	if (engine->gate_owned && ssdk_flow_gate_invalidate(engine->dev) == -EIO) {
+		ret = -EIO; goto out;
+	}
+#define RELEASE(member, fn) do { \
+	if (engine->member) { ret = fn(engine->member); if (ret) goto out; engine->member = NULL; } \
+} while (0)
+	RELEASE(state, ssdk_flow_state_destroy);
+	RELEASE(hw, ssdk_flow_hw_destroy);
+	RELEASE(napt, ssdk_flow_napt_destroy);
+	RELEASE(hosts, ssdk_flow_host_destroy);
+	RELEASE(acl, ssdk_flow_acl_owner_destroy);
+	if (engine->profile) {
+		ret = ssdk_flow_profile_restore(engine->profile);
+		if (ret) goto out;
+	}
+	if (engine->gate_owned) {
+		ret = ssdk_flow_gate_release(engine->dev);
+		if (ret) goto out;
+		WRITE_ONCE(engine->gate_owned, false);
+	}
+	RELEASE(profile, ssdk_flow_profile_destroy);
+#undef RELEASE
+out:
+	mutex_unlock(&engine->lock);
+	if (!ret) kfree(engine);
+	return ret;
+}
--- a/src/ref/ref_flow_gate.c
+++ b/src/ref/ref_flow_gate.c
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/spinlock.h>
+#include "sw.h"
+#include "ssdk_flow_gate.h"
+#define GATE_MOD 0x30
+#define GATE_ROUTER 0xe00
+#define GATE_NAT 0xe38
+#define GATE_L3 BIT(2)
+#define GATE_ACL BIT(1)
+#define GATE_ROUTING BIT(0)
+#define GATE_TRANSLATION (BIT(0) | BIT(1))
+struct ssdk_gate {
+	void __iomem *base;
+	bool owned, enabled, invalidated, protect_acl;
+	u32 original_mod, original_router, original_nat;
+	u64 epoch;
+};
+static DEFINE_RAW_SPINLOCK(gate_lock);
+static struct ssdk_gate gates[SW_MAX_NR_DEV];
+
+static void update_bits(struct ssdk_gate *gate, u32 reg, u32 mask, u32 value)
+{
+	u32 old = readl(gate->base + reg);
+	writel((old & ~mask) | (value & mask), gate->base + reg);
+}
+static bool bits_equal(struct ssdk_gate *gate, u32 reg, u32 mask, u32 value)
+{
+	return (readl(gate->base + reg) & mask) == (value & mask);
+}
+static int stop(struct ssdk_gate *gate)
+{
+	gate->enabled = false;
+	/* Close routing first; enable reverses this order. Readback drains
+	 * posted MMIO writes before a notifier schedules deferred cleanup. */
+	update_bits(gate, GATE_MOD, GATE_L3, 0);
+	update_bits(gate, GATE_ROUTER, GATE_ROUTING, 0);
+	update_bits(gate, GATE_NAT, GATE_TRANSLATION, 0);
+	if (!bits_equal(gate, GATE_MOD, GATE_L3, 0) ||
+	    !bits_equal(gate, GATE_ROUTER, GATE_ROUTING, 0) ||
+	    !bits_equal(gate, GATE_NAT, GATE_TRANSLATION, 0))
+		return -EIO;
+	return 0;
+}
+int ssdk_flow_gate_claim(unsigned int dev, void __iomem *base, size_t size)
+{
+	struct ssdk_gate *gate;
+	unsigned long flags;
+	int ret = 0;
+	if (dev >= SW_MAX_NR_DEV || !base || size < GATE_NAT + 4) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	gate = &gates[dev];
+	if (gate->owned) { ret = -EBUSY; goto out; }
+	/* Do not adopt an independently enabled NAT engine. */
+	if (readl(base + GATE_NAT) & GATE_TRANSLATION) { ret = -EBUSY; goto out; }
+	gate->base = base;
+	gate->original_mod = readl(base + GATE_MOD) & GATE_L3;
+	gate->original_router = readl(base + GATE_ROUTER) & GATE_ROUTING;
+	gate->original_nat = readl(base + GATE_NAT) & GATE_TRANSLATION;
+	gate->epoch++;
+	gate->owned = true; gate->invalidated = false; gate->protect_acl = false;
+	ret = stop(gate);
+	if (ret) {
+		/* No table/profile changes exist at claim time. Restore the
+		 * prior routing state; retain ownership if even that fails. */
+		update_bits(gate, GATE_NAT, GATE_TRANSLATION, gate->original_nat);
+		update_bits(gate, GATE_ROUTER, GATE_ROUTING, gate->original_router);
+		update_bits(gate, GATE_MOD, GATE_L3, gate->original_mod);
+		if (bits_equal(gate, GATE_NAT, GATE_TRANSLATION, gate->original_nat) &&
+		    bits_equal(gate, GATE_ROUTER, GATE_ROUTING, gate->original_router) &&
+		    bits_equal(gate, GATE_MOD, GATE_L3, gate->original_mod)) {
+			gate->owned = false; gate->base = NULL;
+		} else {
+			gate->invalidated = true;
+		}
+	}
+out:
+	raw_spin_unlock_irqrestore(&gate_lock, flags);
+	return ret;
+}
+int ssdk_flow_gate_pause(unsigned int dev, u64 *epoch)
+{
+	unsigned long flags;
+	int ret;
+	if (dev >= SW_MAX_NR_DEV || !epoch) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	if (!gates[dev].owned) ret = -ENODEV;
+	else {
+		ret = stop(&gates[dev]);
+		if (ret) { gates[dev].invalidated = true; gates[dev].epoch++; }
+		*epoch = gates[dev].epoch;
+	}
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return ret;
+}
+int ssdk_flow_gate_invalidate(unsigned int dev)
+{
+	unsigned long flags;
+	int ret;
+	if (dev >= SW_MAX_NR_DEV) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	if (!gates[dev].owned) ret = -ENODEV;
+	else {
+		gates[dev].invalidated = true; gates[dev].epoch++;
+		ret = stop(&gates[dev]);
+	}
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return ret;
+}
+int ssdk_flow_gate_ack(unsigned int dev, u64 epoch)
+{
+	unsigned long flags;
+	int ret = 0;
+	if (dev >= SW_MAX_NR_DEV) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	if (!gates[dev].owned) ret = -ENODEV;
+	else if (gates[dev].epoch != epoch || gates[dev].enabled) ret = -ESTALE;
+	else if (stop(&gates[dev])) {
+		gates[dev].invalidated = true; gates[dev].epoch++; ret = -EIO;
+	}
+	else gates[dev].invalidated = false;
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return ret;
+}
+int ssdk_flow_gate_resume(unsigned int dev, u64 epoch)
+{
+	struct ssdk_gate *gate;
+	unsigned long flags;
+	int ret = 0;
+	if (dev >= SW_MAX_NR_DEV) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	gate = &gates[dev];
+	if (!gate->owned) { ret = -ENODEV; goto out; }
+	if (gate->invalidated || gate->epoch != epoch) { ret = -ESTALE; goto out; }
+	if (!(readl(gate->base + GATE_MOD) & GATE_ACL)) { ret = -EINVAL; goto out; }
+	gate->protect_acl = true;
+	update_bits(gate, GATE_NAT, GATE_TRANSLATION, GATE_TRANSLATION);
+	update_bits(gate, GATE_ROUTER, GATE_ROUTING, GATE_ROUTING);
+	update_bits(gate, GATE_MOD, GATE_L3, GATE_L3);
+	if (!bits_equal(gate, GATE_NAT, GATE_TRANSLATION, GATE_TRANSLATION) ||
+	    !bits_equal(gate, GATE_ROUTER, GATE_ROUTING, GATE_ROUTING) ||
+	    !bits_equal(gate, GATE_MOD, GATE_L3 | GATE_ACL, GATE_L3 | GATE_ACL)) {
+		gate->invalidated = true; gate->epoch++;
+		stop(gate); ret = -EIO;
+	} else gate->enabled = true;
+out:
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return ret;
+}
+bool ssdk_flow_gate_write(unsigned int dev, void __iomem *base, u32 offset, u32 value)
+{
+	struct ssdk_gate *gate;
+	unsigned long flags;
+	if (dev >= SW_MAX_NR_DEV || !base ||
+	    (offset != GATE_MOD && offset != GATE_ROUTER && offset != GATE_NAT)) return false;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	gate = &gates[dev];
+	if (gate->owned && gate->base == base) {
+		if (offset == GATE_MOD) {
+			value = (value & ~GATE_L3) | (gate->enabled ? GATE_L3 : 0);
+			if (gate->protect_acl) value |= GATE_ACL;
+		} else if (offset == GATE_ROUTER) {
+			value = (value & ~GATE_ROUTING) | (gate->enabled ? GATE_ROUTING : 0);
+		} else {
+			value = (value & ~GATE_TRANSLATION) | (gate->enabled ? GATE_TRANSLATION : 0);
+		}
+	}
+	writel(value, base + offset);
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return true;
+}
+int ssdk_flow_gate_release(unsigned int dev)
+{
+	struct ssdk_gate *gate;
+	unsigned long flags;
+	int ret = 0;
+	if (dev >= SW_MAX_NR_DEV) return -EINVAL;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	gate = &gates[dev];
+	if (!gate->owned) goto out;
+	if (gate->enabled) { ret = -EBUSY; goto out; }
+	update_bits(gate, GATE_NAT, GATE_TRANSLATION, gate->original_nat);
+	update_bits(gate, GATE_ROUTER, GATE_ROUTING, gate->original_router);
+	update_bits(gate, GATE_MOD, GATE_L3, gate->original_mod);
+	if (!bits_equal(gate, GATE_NAT, GATE_TRANSLATION, gate->original_nat) ||
+	    !bits_equal(gate, GATE_ROUTER, GATE_ROUTING, gate->original_router) ||
+	    !bits_equal(gate, GATE_MOD, GATE_L3, gate->original_mod)) {
+		gate->invalidated = true; gate->epoch++; stop(gate); ret = -EIO;
+	} else {
+		gate->owned = false; gate->base = NULL; gate->epoch++;
+	}
+out:
+	raw_spin_unlock_irqrestore(&gate_lock, flags); return ret;
+}
+
+bool ssdk_flow_gate_valid(unsigned int dev)
+{
+	unsigned long flags;
+	bool valid;
+	if (dev >= SW_MAX_NR_DEV) return false;
+	raw_spin_lock_irqsave(&gate_lock, flags);
+	valid = gates[dev].owned && !gates[dev].invalidated;
+	raw_spin_unlock_irqrestore(&gate_lock, flags);
+	return valid;
+}
--- a/src/ref/ref_flow_host.c
+++ b/src/ref/ref_flow_host.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/err.h>
+#include <linux/etherdevice.h>
+#include <linux/slab.h>
+#include <linux/in.h>
+#include "sw.h"
+#include "fal_ip.h"
+#include "fal_reg_access.h"
+#include "ssdk_flow_host.h"
+#define FLOW_HOSTS 16
+#define FLOW_INTERFACES 8
+#define DESS_INTF_VALID 0x5a908
+struct flow_interface {
+	bool used, ready;
+	unsigned int refs;
+	fal_intf_mac_entry_t entry;
+};
+struct flow_host {
+	bool used, ready, host_attempted, route_attempted;
+	unsigned int refs;
+	int interface;
+	struct ssdk_flow_path path;
+	fal_host_entry_t entry;
+};
+struct ssdk_flow_host {
+	unsigned int dev;
+	struct flow_interface interfaces[FLOW_INTERFACES];
+	struct flow_host hosts[FLOW_HOSTS];
+};
+struct ssdk_flow_host *ssdk_flow_host_create(unsigned int dev)
+{
+	struct ssdk_flow_host *table;
+	fal_host_entry_t host = { .entry_id = FAL_NEXT_ENTRY_FIRST_ID };
+	fal_intf_mac_entry_t interface = { .entry_id = FAL_NEXT_ENTRY_FIRST_ID };
+	fal_host_route_t route = {};
+	a_uint32_t word;
+	unsigned int i;
+	sw_error_t rv;
+	rv = fal_ip_host_next(dev, 0, &host);
+	if (rv != SW_NO_MORE) return ERR_PTR(rv == SW_OK ? -EBUSY : -EIO);
+	rv = fal_ip_intf_entry_next(dev, 0, &interface);
+	if (rv != SW_NO_MORE) return ERR_PTR(rv == SW_OK ? -EBUSY : -EIO);
+	/* The SDK interface iterator follows a software shadow: also reject
+	 * hardware route bits left by an interrupted interface installation. */
+	for (i = 0; i < FLOW_INTERFACES; i++) {
+		if (fal_reg_get(dev, DESS_INTF_VALID + (i << 4), (a_uint8_t *)&word, sizeof(word)) != SW_OK)
+			return ERR_PTR(-EIO);
+		if (word & (BIT(8) | BIT(9))) return ERR_PTR(-EBUSY);
+	}
+	for (i = 0; i < FLOW_HOSTS; i++) {
+		route.ip_version = FAL_ADDR_IPV4;
+		if (fal_ip_host_route_get(dev, i, &route) != SW_OK) return ERR_PTR(-EIO);
+		if (route.valid) return ERR_PTR(-EBUSY);
+		route.ip_version = FAL_ADDR_IPV6;
+		if (fal_ip_host_route_get(dev, i, &route) != SW_OK) return ERR_PTR(-EIO);
+		if (route.valid) return ERR_PTR(-EBUSY);
+	}
+	table = kzalloc(sizeof(*table), GFP_KERNEL);
+	if (!table) return ERR_PTR(-ENOMEM);
+	table->dev = dev; return table;
+}
+static bool same_path(const struct ssdk_flow_path *a, const struct ssdk_flow_path *b)
+{
+	return a->address == b->address && a->vid == b->vid && a->port == b->port &&
+		ether_addr_equal(a->router, b->router) && ether_addr_equal(a->neighbour, b->neighbour);
+}
+static int interface_get(struct ssdk_flow_host *table, const struct ssdk_flow_path *path, int *handle)
+{
+	struct flow_interface *interface;
+	int i, free = -1;
+	for (i = 0; i < FLOW_INTERFACES; i++) {
+		interface = &table->interfaces[i];
+		if (!interface->used) { if (free < 0) free = i; continue; }
+		if (interface->entry.vid_low != path->vid) continue;
+		if (!interface->ready) return -EIO;
+		if (!ether_addr_equal(interface->entry.mac_addr.uc, path->router)) return -EEXIST;
+		interface->refs++; *handle = i; return 0;
+	}
+	if (free < 0) return -ENOSPC;
+	interface = &table->interfaces[free];
+	interface->used = true; interface->refs = 1;
+	interface->entry.entry_id = FLOW_INTERFACES;
+	interface->entry.vid_low = interface->entry.vid_high = path->vid;
+	interface->entry.ip4_route = A_TRUE;
+	ether_addr_copy(interface->entry.mac_addr.uc, path->router);
+	*handle = free;
+	if (fal_ip_intf_entry_add(table->dev, &interface->entry) != SW_OK) {
+		if (interface->entry.entry_id >= FLOW_INTERFACES) {
+			memset(interface, 0, sizeof(*interface)); *handle = -1;
+		}
+		return -EIO;
+	}
+	if (interface->entry.entry_id >= FLOW_INTERFACES) return -EIO;
+	interface->ready = true; return 0;
+}
+static int interface_put(struct ssdk_flow_host *table, int handle)
+{
+	struct flow_interface *interface = &table->interfaces[handle];
+	if (interface->refs > 1) { interface->refs--; return 0; }
+	if (fal_ip_intf_entry_del(table->dev, FAL_IP_ENTRY_ID_EN, &interface->entry) != SW_OK)
+		return -EIO;
+	memset(interface, 0, sizeof(*interface)); return 0;
+}
+int ssdk_flow_host_get(struct ssdk_flow_host *table, const struct ssdk_flow_path *path,
+		      int *handle, u16 *arp)
+{
+	struct flow_host *host;
+	fal_host_entry_t probe;
+	fal_host_route_t route = {};
+	int i, free = -1, ret;
+	if (!handle || !arp) return -EINVAL;
+	*handle = -1;
+	if (!path || !path->address || !path->vid || path->vid >= 4095 ||
+	    ipv4_is_zeronet(path->address) || ipv4_is_loopback(path->address) ||
+	    ntohl(path->address) >= 0xe0000000 ||
+	    !path->port || path->port > 5 || !is_valid_ether_addr(path->router) ||
+	    !is_valid_ether_addr(path->neighbour)) return -EOPNOTSUPP;
+	for (i = 0; i < FLOW_HOSTS; i++) {
+		host = &table->hosts[i];
+		if (!host->used) { if (free < 0) free = i; continue; }
+		if (!host->ready) return -EIO; /* Finish uncertain cleanup first. */
+		if (host->path.address != path->address) continue;
+		/* DESS host keys do not distinguish overlapping IPv4 subnets. */
+		if (!host->ready) return -EIO;
+		if (!same_path(&host->path, path)) return -EEXIST;
+		host->refs++; *handle = i; *arp = host->entry.entry_id; return 0;
+	}
+	if (free < 0) return -ENOSPC;
+	host = &table->hosts[free];
+	host->used = true; host->refs = 1; host->interface = -1; host->path = *path;
+	*handle = free;
+	ret = interface_get(table, path, &host->interface);
+	if (ret) return ret;
+	host->entry.flags = FAL_IP_IP4_ADDR | FAL_IP_HOST_NO_ROUTE;
+	host->entry.ip4_addr = ntohl(path->address);
+	host->entry.intf_id = path->vid; /* FAL accepts VID, then encodes HW index. */
+	host->entry.port_id = path->port;
+	host->entry.status = 7; /* Static neighbour; lifetime belongs to Linux. */
+	host->entry.action = FAL_MAC_FRWRD;
+	ether_addr_copy(host->entry.mac_addr.uc, path->neighbour);
+	host->host_attempted = true;
+	if (fal_ip_host_add(table->dev, &host->entry) != SW_OK) return -EIO;
+	probe = host->entry;
+	if (fal_ip_host_get(table->dev, FAL_IP_ENTRY_IPADDR_EN, &probe) != SW_OK) return -EIO;
+	if (probe.entry_id >= 128 || probe.ip4_addr != host->entry.ip4_addr ||
+	    probe.port_id != path->port || probe.intf_id != path->vid ||
+	    !probe.status || probe.counter_en ||
+	    !ether_addr_equal(probe.mac_addr.uc, path->neighbour)) return -EIO;
+	host->entry.entry_id = probe.entry_id;
+	/* SDK prefix encoding is length minus one: /16 uses 15, /32 uses 31.
+	 * A host receives an exact route instead of the legacy automatic /16. */
+	route.ip_version = FAL_ADDR_IPV4; route.valid = A_TRUE;
+	route.prefix_length = 31; route.route_addr.ip4_addr = host->entry.ip4_addr;
+	host->route_attempted = true;
+	if (fal_ip_host_route_set(table->dev, free, &route) != SW_OK) return -EIO;
+	host->ready = true; *arp = host->entry.entry_id; return 0;
+}
+int ssdk_flow_host_put(struct ssdk_flow_host *table, int handle)
+{
+	struct flow_host *host;
+	fal_host_entry_t probe;
+	fal_host_route_t route = {};
+	sw_error_t rv;
+	if (handle < 0 || handle >= FLOW_HOSTS) return -EINVAL;
+	host = &table->hosts[handle];
+	if (!host->used) return 0;
+	if (host->refs > 1) { host->refs--; return 0; }
+	host->ready = false;
+	if (host->route_attempted) {
+		route.ip_version = FAL_ADDR_IPV4;
+		if (fal_ip_host_route_set(table->dev, handle, &route) != SW_OK) return -EIO;
+		host->route_attempted = false;
+	}
+	if (host->host_attempted) {
+		rv = fal_ip_host_del(table->dev, FAL_IP_ENTRY_IPADDR_EN, &host->entry);
+		if (rv != SW_OK && rv != SW_NOT_FOUND) {
+			probe = host->entry;
+			if (fal_ip_host_get(table->dev, FAL_IP_ENTRY_IPADDR_EN, &probe) != SW_NOT_FOUND)
+				return -EIO;
+		}
+		host->host_attempted = false;
+	}
+	if (host->interface >= 0 && interface_put(table, host->interface)) return -EIO;
+	memset(host, 0, sizeof(*host)); return 0;
+}
+int ssdk_flow_host_destroy(struct ssdk_flow_host *table)
+{
+	unsigned int i;
+	int ret = 0;
+	if (!table) return 0;
+	for (i = 0; i < FLOW_HOSTS; i++) {
+		if (!table->hosts[i].used) continue;
+		/* Global shutdown revokes every reference after ACL users stop. */
+		table->hosts[i].refs = 1;
+		if (ssdk_flow_host_put(table, i)) ret = -EIO;
+	}
+	if (!ret) kfree(table);
+	return ret;
+}
--- a/src/ref/ref_flow_hw.c
+++ b/src/ref/ref_flow_hw.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/etherdevice.h>
+#include <linux/slab.h>
+#include "ssdk_flow_hw.h"
+#include "ssdk_flow_acl_owner.h"
+#include "ssdk_flow_napt.h"
+#include "ssdk_flow_gate.h"
+#include "ssdk_flow_path.h"
+struct hw_slot {
+	bool used, ready;
+	int guards[2], hosts[2];
+	struct ssdk_flow_path paths[2];
+};
+struct ssdk_flow_hw {
+	unsigned int dev;
+	struct ssdk_flow_acl_owner *acl;
+	struct ssdk_flow_host *hosts;
+	struct ssdk_flow_napt *napt;
+	ssdk_flow_resolve_t resolve;
+	void *ctx;
+	struct hw_slot slots[SSDK_FLOW_COUNTERS];
+};
+static bool any_ready(struct ssdk_flow_hw *hw)
+{
+	unsigned int i;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (hw->slots[i].ready) return true;
+	return false;
+}
+static int failed(struct ssdk_flow_hw *hw, int error)
+{
+	/* Stop other installed connections too: an incomplete ACL relocation
+	 * or invalidated path must never be followed by a speculative resume. */
+	ssdk_flow_gate_invalidate(hw->dev);
+	return error;
+}
+static int hw_install(void *ctx, unsigned int slot, const struct ssdk_flow_rule rules[2],
+		      const struct ssdk_flow_pair *pair, struct ssdk_flow_counts *baseline)
+{
+	struct ssdk_flow_hw *hw = ctx;
+	struct ssdk_flow_path paths[2];
+	struct ssdk_flow_acl_path acl_paths[2];
+	struct hw_slot *flow;
+	u16 arp[2];
+	u64 epoch;
+	unsigned int i;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS || !rules || !pair || !baseline ||
+	    pair->outbound_direction > 1) return -EINVAL;
+	flow = &hw->slots[slot];
+	if (flow->used) return -EBUSY;
+	ret = ssdk_flow_gate_pause(hw->dev, &epoch);
+	if (ret) return failed(hw, ret);
+	memset(paths, 0, sizeof(paths));
+	ret = hw->resolve(hw->ctx, rules, paths);
+	if (ret) return failed(hw, ret);
+	for (i = 0; i < 2; i++) {
+		/* The action's L2 rewrite must agree with the live next hop. */
+		if (!ether_addr_equal(paths[i].router, rules[i].source) ||
+		    !ether_addr_equal(paths[i].neighbour, rules[i].destination) ||
+		    !paths[i].vid || paths[i].vid >= 4095 ||
+		    !paths[i].port || paths[i].port > 5 ||
+		    (rules[i].vlan_push && rules[i].egress_vid != paths[i].vid) ||
+		    (rules[i].vlan_match && rules[i].ingress_vid != paths[1-i].vid))
+			return failed(hw, -EOPNOTSUPP);
+	}
+	flow->used = true;
+	memcpy(flow->paths, paths, sizeof(paths));
+	for (i = 0; i < 2; i++) flow->guards[i] = flow->hosts[i] = -1;
+	/* Both router guards precede either routed interface. Handles are
+	 * published even on partial failure; state.remove owns rollback. */
+	for (i = 0; i < 2; i++) {
+		ret = ssdk_flow_guard_get(hw->acl, paths[i].router, &flow->guards[i]);
+		if (ret) return failed(hw, ret);
+	}
+	for (i = 0; i < 2; i++) {
+		ret = ssdk_flow_host_get(hw->hosts, &paths[i], &flow->hosts[i], &arp[i]);
+		if (ret) return failed(hw, ret);
+	}
+	ret = ssdk_flow_napt_add(hw->napt, slot, pair, baseline);
+	if (ret) return failed(hw, ret);
+	for (i = 0; i < 2; i++) {
+		/* Match the ingress side, but redirect through the egress ARP. */
+		acl_paths[i].guard = flow->guards[1-i];
+		acl_paths[i].port = paths[1-i].port;
+		acl_paths[i].vid = paths[1-i].vid;
+		acl_paths[i].arp = arp[i];
+	}
+	ret = ssdk_flow_permission_add(hw->acl, slot, rules, acl_paths, pair->outbound_direction);
+	if (ret) return failed(hw, ret);
+	ret = ssdk_flow_gate_resume(hw->dev, epoch);
+	if (ret) return failed(hw, ret);
+	flow->ready = true;
+	return 0;
+}
+static int hw_remove(void *ctx, unsigned int slot)
+{
+	struct ssdk_flow_hw *hw = ctx;
+	struct hw_slot *flow;
+	u64 epoch;
+	unsigned int i;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS) return -EINVAL;
+	flow = &hw->slots[slot];
+	if (!flow->used) return 0;
+	ret = ssdk_flow_gate_pause(hw->dev, &epoch);
+	if (ret) return failed(hw, ret);
+	flow->ready = false;
+	ret = ssdk_flow_permission_remove(hw->acl, slot);
+	if (ret) return failed(hw, ret);
+	ret = ssdk_flow_napt_remove(hw->napt, slot);
+	if (ret) return failed(hw, ret);
+	for (i = 0; i < 2; i++) {
+		if (flow->hosts[i] < 0) continue;
+		ret = ssdk_flow_host_put(hw->hosts, flow->hosts[i]);
+		if (ret) return failed(hw, ret);
+		flow->hosts[i] = -1;
+	}
+	/* Never remove a router guard while either routed interface remains. */
+	for (i = 0; i < 2; i++) {
+		if (flow->guards[i] < 0) continue;
+		ret = ssdk_flow_guard_put(hw->acl, flow->guards[i]);
+		if (ret) return failed(hw, ret);
+		flow->guards[i] = -1;
+	}
+	memset(flow, 0, sizeof(*flow));
+	if (!any_ready(hw)) return 0;
+	ret = ssdk_flow_gate_resume(hw->dev, epoch);
+	/* Cleanup succeeded even if a notifier superseded this transaction.
+	 * Keep the global gate stopped; deferred invalidation flushes peers. */
+	if (ret == -ESTALE) return 0;
+	return ret ? failed(hw, ret) : 0;
+}
+static int hw_read(void *ctx, unsigned int slot, struct ssdk_flow_counts *counts)
+{
+	struct ssdk_flow_hw *hw = ctx;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS || !hw->slots[slot].ready) return -ENOENT;
+	ret = ssdk_flow_path_alive(hw->dev, &hw->slots[slot].paths[0]);
+	if (!ret) ret = ssdk_flow_path_alive(hw->dev, &hw->slots[slot].paths[1]);
+	if (ret) return failed(hw, ret);
+	ret = ssdk_flow_napt_read(hw->napt, slot, counts);
+	return ret ? failed(hw, ret) : 0;
+}
+const struct ssdk_flow_ops ssdk_flow_hw_ops = {
+	.install = hw_install, .remove = hw_remove, .read = hw_read,
+};
+struct ssdk_flow_hw *ssdk_flow_hw_create(unsigned int dev,
+	struct ssdk_flow_acl_owner *acl, struct ssdk_flow_host *hosts,
+	struct ssdk_flow_napt *napt, ssdk_flow_resolve_t resolve, void *ctx)
+{
+	struct ssdk_flow_hw *hw;
+	if (!acl || !hosts || !napt || !resolve) return NULL;
+	hw = kzalloc(sizeof(*hw), GFP_KERNEL);
+	if (!hw) return NULL;
+	hw->dev = dev; hw->acl = acl; hw->hosts = hosts; hw->napt = napt;
+	hw->resolve = resolve; hw->ctx = ctx;
+	return hw;
+}
+int ssdk_flow_hw_destroy(struct ssdk_flow_hw *hw)
+{
+	unsigned int i;
+	int ret = 0;
+	if (!hw) return 0;
+	/* State callbacks must already be quiesced. Prevent a peer slot from
+	 * resuming forwarding between successive shutdown removals. */
+	ssdk_flow_gate_invalidate(hw->dev);
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (hw_remove(hw, i)) ret = -EIO;
+	if (!ret) kfree(hw);
+	return ret;
+}
--- a/src/ref/ref_flow_napt.c
+++ b/src/ref/ref_flow_napt.c
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/err.h>
+#include <linux/in.h>
+#include <linux/slab.h>
+#include "sw.h"
+#include "fal_nat.h"
+#include "fal_reg_access.h"
+#define DESS_PUBLIC_VALID 0x2f040
+#include "ssdk_flow_napt.h"
+struct ssdk_flow_public {
+	bool used, owned;
+	unsigned int refs;
+	fal_nat_pub_addr_t entry;
+};
+struct ssdk_flow_napt_entry {
+	bool used, attempted;
+	int public;
+	fal_napt_entry_t entry;
+};
+struct ssdk_flow_napt {
+	unsigned int dev;
+	struct ssdk_flow_public public[SSDK_FLOW_COUNTERS];
+	struct ssdk_flow_napt_entry entries[SSDK_FLOW_COUNTERS];
+};
+struct ssdk_flow_napt *ssdk_flow_napt_create(unsigned int dev)
+{
+	fal_nat_pub_addr_t pub = { .entry_id = FAL_NEXT_ENTRY_FIRST_ID };
+	fal_napt_entry_t napt = { .entry_id = FAL_NEXT_ENTRY_FIRST_ID };
+	fal_nat_entry_t nat = { .entry_id = FAL_NEXT_ENTRY_FIRST_ID };
+	struct ssdk_flow_napt *table;
+	a_uint32_t bitmap;
+	sw_error_t rv;
+	/* A failed old ADD can leave an enabled offload bit without a
+	 * searchable public entry. Do not adopt or overwrite that resource. */
+	rv = fal_reg_get(dev, DESS_PUBLIC_VALID, (a_uint8_t *)&bitmap, sizeof(bitmap));
+	if (rv != SW_OK) return ERR_PTR(-EIO);
+	if (bitmap & 0xffff) return ERR_PTR(-EBUSY);
+	rv = fal_nat_pub_addr_next(dev, 0, &pub);
+	if (rv != SW_NO_MORE) return ERR_PTR(rv == SW_OK ? -EBUSY : -EIO);
+	rv = fal_napt_next(dev, 0, &napt);
+	if (rv != SW_NO_MORE) return ERR_PTR(rv == SW_OK ? -EBUSY : -EIO);
+	rv = fal_nat_next(dev, 0, &nat);
+	if (rv != SW_NO_MORE) return ERR_PTR(rv == SW_OK ? -EBUSY : -EIO);
+	table = kzalloc(sizeof(*table), GFP_KERNEL);
+	if (!table) return ERR_PTR(-ENOMEM);
+	table->dev = dev;
+	return table;
+}
+static int public_get(struct ssdk_flow_napt *table, fal_ip4_addr_t address, int *index)
+{
+	struct ssdk_flow_public *pub;
+	int i, free = -1;
+	sw_error_t rv;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++) {
+		pub = &table->public[i];
+		if (!pub->used) { if (free < 0) free = i; continue; }
+		if (pub->entry.pub_addr == address) {
+			if (!pub->owned) return -EIO;
+			pub->refs++; *index = i; return 0;
+		}
+	}
+	if (free < 0) return -ENOSPC;
+	pub = &table->public[free];
+	pub->used = true; pub->refs = 1; pub->entry.pub_addr = address;
+	pub->entry.entry_id = 16;
+	*index = free;
+	rv = fal_nat_pub_addr_add(table->dev, &pub->entry);
+	if (rv == SW_OK) { pub->owned = true; return 0; }
+	/* A successful scan publishes the chosen index before any write. A
+	 * partially written slot must be retained for explicit index cleanup. */
+	if (rv == SW_ALREADY_EXIST || pub->entry.entry_id >= 16) {
+		memset(pub, 0, sizeof(*pub)); *index = -1;
+	}
+	return rv == SW_ALREADY_EXIST ? -EEXIST : -EIO;
+}
+static int public_put(struct ssdk_flow_napt *table, int index)
+{
+	struct ssdk_flow_public *pub = &table->public[index];
+	if (pub->refs > 1) { pub->refs--; return 0; }
+	if (fal_nat_pub_addr_del(table->dev, FAL_NAT_PUBLIC_OWNED_INDEX, &pub->entry) != SW_OK)
+		return -EIO;
+	memset(pub, 0, sizeof(*pub)); return 0;
+}
+int ssdk_flow_napt_read(struct ssdk_flow_napt *table, unsigned int slot,
+			struct ssdk_flow_counts *counts)
+{
+	fal_napt_entry_t entry;
+	const fal_napt_entry_t *expected;
+	if (slot >= SSDK_FLOW_COUNTERS || !counts || !table->entries[slot].used ||
+	    !table->entries[slot].attempted) return -ENOENT;
+	expected = &table->entries[slot].entry;
+	entry = *expected;
+	if (fal_napt_get(table->dev, FAL_NAT_ENTRY_KEY_EN, &entry) != SW_OK)
+		return -EIO;
+	if (!entry.counter_en || entry.counter_id != slot || !entry.status ||
+	    entry.src_addr != expected->src_addr || entry.dst_addr != expected->dst_addr ||
+	    entry.src_port != expected->src_port || entry.dst_port != expected->dst_port ||
+	    entry.trans_addr != expected->trans_addr || entry.trans_port != expected->trans_port ||
+	    ((entry.flags ^ expected->flags) & (FAL_NAT_ENTRY_PROTOCOL_TCP |
+		FAL_NAT_ENTRY_PROTOCOL_UDP | FAL_NAT_ENTRY_TRANS_IPADDR_INDEX))) return -EIO;
+	/* The vendor conntrack accounting maps egress to SNAT original and
+	 * ingress to its reply; DNAT reverses original/reply, not these axes. */
+	counts->packets[0] = entry.egress_packet; counts->bytes[0] = entry.egress_byte;
+	counts->packets[1] = entry.ingress_packet; counts->bytes[1] = entry.ingress_byte;
+	return 0;
+}
+int ssdk_flow_napt_add(struct ssdk_flow_napt *table, unsigned int slot,
+		       const struct ssdk_flow_pair *pair, struct ssdk_flow_counts *baseline)
+{
+	struct ssdk_flow_napt_entry *flow;
+	int ret;
+	if (slot >= SSDK_FLOW_COUNTERS || !pair || !baseline ||
+	    (pair->protocol != IPPROTO_TCP && pair->protocol != IPPROTO_UDP)) return -EINVAL;
+	flow = &table->entries[slot];
+	if (flow->used) return -EBUSY;
+	flow->used = true; flow->public = -1;
+	ret = public_get(table, ntohl(pair->translated.src), &flow->public);
+	if (ret) return ret;
+	flow->entry.src_addr = ntohl(pair->outbound.src);
+	flow->entry.dst_addr = ntohl(pair->outbound.dst);
+	flow->entry.src_port = ntohs(pair->outbound.sport);
+	flow->entry.dst_port = ntohs(pair->outbound.dport);
+	flow->entry.trans_port = ntohs(pair->translated.sport);
+	flow->entry.trans_addr = table->public[flow->public].entry.entry_id;
+	flow->entry.flags = FAL_NAT_ENTRY_TRANS_IPADDR_INDEX |
+		(pair->protocol == IPPROTO_TCP ? FAL_NAT_ENTRY_PROTOCOL_TCP : FAL_NAT_ENTRY_PROTOCOL_UDP);
+	flow->entry.status = 0xe; /* Same active status as the vendor helper. */
+	flow->entry.action = FAL_MAC_FRWRD;
+	flow->entry.counter_en = A_TRUE; flow->entry.counter_id = slot;
+	flow->attempted = true;
+	if (fal_napt_add(table->dev, &flow->entry) != SW_OK) return -EIO;
+	return ssdk_flow_napt_read(table, slot, baseline);
+}
+int ssdk_flow_napt_remove(struct ssdk_flow_napt *table, unsigned int slot)
+{
+	struct ssdk_flow_napt_entry *flow;
+	fal_napt_entry_t probe;
+	sw_error_t rv;
+	if (slot >= SSDK_FLOW_COUNTERS) return -EINVAL;
+	flow = &table->entries[slot];
+	if (!flow->used) return 0;
+	if (flow->attempted) {
+		rv = fal_napt_del(table->dev, FAL_NAT_ENTRY_KEY_EN, &flow->entry);
+		if (rv != SW_OK && rv != SW_NOT_FOUND) {
+			probe = flow->entry;
+			if (fal_napt_get(table->dev, FAL_NAT_ENTRY_KEY_EN, &probe) != SW_NOT_FOUND)
+				return -EIO;
+		}
+		flow->attempted = false;
+	}
+	if (flow->public >= 0 && public_put(table, flow->public)) return -EIO;
+	memset(flow, 0, sizeof(*flow)); return 0;
+}
+int ssdk_flow_napt_destroy(struct ssdk_flow_napt *table)
+{
+	unsigned int i;
+	int ret = 0;
+	if (!table) return 0;
+	for (i = 0; i < SSDK_FLOW_COUNTERS; i++)
+		if (ssdk_flow_napt_remove(table, i)) ret = -EIO;
+	if (!ret) kfree(table);
+	return ret;
+}
--- a/src/ref/ref_flow_parse.c
+++ b/src/ref/ref_flow_parse.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Strict normalization of Linux flowtable rules before DESS resource changes. */
+#include <linux/etherdevice.h>
+#include <linux/ip.h>
+#include <linux/if_vlan.h>
+#include <linux/in.h>
+#include <linux/tc_act/tc_csum.h>
+#include <net/flow_offload.h>
+#include "ssdk_flow.h"
+
+static int ssdk_flow_mangle_bytes(u8 *bytes, unsigned int length,
+				 const struct flow_action_entry *action, u16 *written)
+{
+	u8 mask[4], value[4];
+	unsigned int i, offset = action->mangle.offset;
+
+	if (offset > length || length - offset < sizeof(value))
+		return -EOPNOTSUPP;
+	memcpy(mask, &action->mangle.mask, sizeof(mask));
+	memcpy(value, &action->mangle.val, sizeof(value));
+	for (i = 0; i < sizeof(value); i++) {
+		/* Only complete bytes are representable by the normalized tuples
+		 * and MACs. Do not reinterpret native-endian action words. */
+		if ((mask[i] != 0 && mask[i] != 0xff) || (value[i] & mask[i]))
+			return -EOPNOTSUPP;
+		bytes[offset + i] = (bytes[offset + i] & mask[i]) | value[i];
+		if (written && !mask[i])
+			*written |= BIT(offset + i);
+	}
+	return 0;
+}
+
+int ssdk_flow_parse(const struct flow_rule *rule, struct ssdk_flow_rule *result)
+{
+	const u64 required = BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) | BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS) | BIT_ULL(FLOW_DISSECTOR_KEY_PORTS);
+	const u64 allowed = required | BIT_ULL(FLOW_DISSECTOR_KEY_TCP) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_VLAN);
+	struct flow_match_meta meta;
+	struct flow_match_control control;
+	struct flow_match_basic basic;
+	struct flow_match_ipv4_addrs ipv4;
+	struct flow_match_ports ports;
+	struct ssdk_flow_rule parsed = {};
+	const struct flow_action_entry *action;
+	u8 ethernet[ETH_ALEN * 2] = {};
+	u16 ethernet_written = 0;
+	u32 expected_csum;
+	bool checksum = false, redirected = false;
+	int i, ret;
+
+	if (!rule || !result || !rule->match.dissector ||
+	    (rule->match.dissector->used_keys & required) != required ||
+	    (rule->match.dissector->used_keys & ~allowed))
+		return -EOPNOTSUPP;
+	flow_rule_match_meta(rule, &meta);
+	flow_rule_match_control(rule, &control);
+	flow_rule_match_basic(rule, &basic);
+	flow_rule_match_ipv4_addrs(rule, &ipv4);
+	flow_rule_match_ports(rule, &ports);
+	if (meta.mask->ingress_ifindex != -1 || meta.key->ingress_ifindex <= 0 ||
+	    meta.mask->ingress_iftype || meta.mask->l2_miss ||
+	    control.mask->addr_type != 0xffff || control.mask->thoff ||
+	    control.mask->flags || control.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
+	    basic.mask->n_proto != htons(0xffff) || basic.mask->ip_proto != 0xff ||
+	    basic.mask->padding || basic.key->n_proto != htons(ETH_P_IP) ||
+	    ipv4.mask->src != htonl(0xffffffff) || ipv4.mask->dst != htonl(0xffffffff) ||
+	    ports.mask->src != htons(0xffff) || ports.mask->dst != htons(0xffff))
+		return -EOPNOTSUPP;
+	if (basic.key->ip_proto != IPPROTO_TCP && basic.key->ip_proto != IPPROTO_UDP)
+		return -EOPNOTSUPP;
+	parsed.ingress_ifindex = meta.key->ingress_ifindex;
+	parsed.protocol = basic.key->ip_proto;
+	parsed.match.src = ipv4.key->src;
+	parsed.match.dst = ipv4.key->dst;
+	parsed.match.sport = ports.key->src;
+	parsed.match.dport = ports.key->dst;
+	parsed.translated = parsed.match;
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_TCP)) {
+		struct flow_match_tcp tcp;
+		u16 flags, mask;
+
+		flow_rule_match_tcp(rule, &tcp);
+		flags = ntohs(tcp.key->flags);
+		mask = ntohs(tcp.mask->flags);
+		if (parsed.protocol != IPPROTO_TCP || (mask & ~0x07) || (flags & mask))
+			return -EOPNOTSUPP;
+		parsed.tcp_mask = mask;
+	}
+	/* SYN/FIN/RST and IP fragments will always be trapped by the hardware
+	 * eligibility guard, even if the input rule has no such match fields. */
+	if (parsed.protocol == IPPROTO_TCP)
+		parsed.tcp_mask |= 0x07;
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN)) {
+		struct flow_match_vlan vlan;
+
+		flow_rule_match_vlan(rule, &vlan);
+		if (vlan.mask->vlan_id != VLAN_VID_MASK || vlan.mask->vlan_priority ||
+		    vlan.mask->vlan_dei || vlan.mask->vlan_eth_type || vlan.mask->padding ||
+		    vlan.mask->vlan_tpid != htons(0xffff) ||
+		    vlan.key->vlan_tpid != htons(ETH_P_8021Q) ||
+		    !vlan.key->vlan_id || vlan.key->vlan_id >= VLAN_VID_MASK)
+			return -EOPNOTSUPP;
+		parsed.vlan_match = true;
+		parsed.ingress_vid = vlan.key->vlan_id;
+	}
+	expected_csum = TCA_CSUM_UPDATE_FLAG_IPV4HDR |
+		(parsed.protocol == IPPROTO_TCP ? TCA_CSUM_UPDATE_FLAG_TCP : TCA_CSUM_UPDATE_FLAG_UDP);
+	flow_action_for_each(i, action, &rule->action) {
+		if (redirected)
+			return -EOPNOTSUPP;
+		switch (action->id) {
+		case FLOW_ACTION_MANGLE:
+			switch (action->mangle.htype) {
+			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+				ret = ssdk_flow_mangle_bytes(ethernet, sizeof(ethernet), action,
+							    &ethernet_written);
+				if (ret)
+					return ret;
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+				if (action->mangle.mask)
+					return -EOPNOTSUPP;
+				if (action->mangle.offset == offsetof(struct iphdr, saddr))
+					memcpy(&parsed.translated.src, &action->mangle.val, 4);
+				else if (action->mangle.offset == offsetof(struct iphdr, daddr))
+					memcpy(&parsed.translated.dst, &action->mangle.val, 4);
+				else
+					return -EOPNOTSUPP;
+				checksum = false;
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+				if ((action->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_TCP) !=
+				    (parsed.protocol == IPPROTO_TCP) || action->mangle.offset)
+					return -EOPNOTSUPP;
+				/* sport/dport are adjacent network-order words. */
+				ret = ssdk_flow_mangle_bytes((u8 *)&parsed.translated.sport, 4, action, NULL);
+				if (ret)
+					return ret;
+				checksum = false;
+				break;
+			default:
+				return -EOPNOTSUPP;
+			}
+			break;
+		case FLOW_ACTION_CSUM:
+			if (action->csum_flags != expected_csum)
+				return -EOPNOTSUPP;
+			checksum = true;
+			break;
+		case FLOW_ACTION_VLAN_POP:
+			if (parsed.vlan_pop || parsed.vlan_push || !parsed.vlan_match)
+				return -EOPNOTSUPP;
+			parsed.vlan_pop = true;
+			break;
+		case FLOW_ACTION_VLAN_PUSH:
+			if (parsed.vlan_push || action->vlan.proto != htons(ETH_P_8021Q) ||
+			    action->vlan.prio || !action->vlan.vid || action->vlan.vid >= VLAN_VID_MASK)
+				return -EOPNOTSUPP;
+			parsed.vlan_push = true;
+			parsed.egress_vid = action->vlan.vid;
+			break;
+		case FLOW_ACTION_REDIRECT:
+			if (!action->dev)
+				return -EOPNOTSUPP;
+			parsed.egress = action->dev;
+			redirected = true;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+	if (!redirected || ethernet_written != GENMASK(11, 0) ||
+	    !is_valid_ether_addr(ethernet) || !is_valid_ether_addr(ethernet + ETH_ALEN) ||
+	    (parsed.vlan_match && !parsed.vlan_pop) ||
+	    (memcmp(&parsed.match, &parsed.translated, sizeof(parsed.match)) && !checksum))
+		return -EOPNOTSUPP;
+	memcpy(parsed.destination, ethernet, ETH_ALEN);
+	memcpy(parsed.source, ethernet + ETH_ALEN, ETH_ALEN);
+	*result = parsed;
+	return 0;
+}
+
+static bool ssdk_flow_reverse(const struct ssdk_flow_tuple *a,
+			      const struct ssdk_flow_tuple *b)
+{
+	return a->src == b->dst && a->dst == b->src &&
+		a->sport == b->dport && a->dport == b->sport;
+}
+
+int ssdk_flow_pair(const struct ssdk_flow_rule rules[2], struct ssdk_flow_pair *result)
+{
+	struct ssdk_flow_pair pair = {};
+	unsigned int i;
+
+	if (!rules || !result || rules[0].protocol != rules[1].protocol ||
+	    (rules[0].protocol != IPPROTO_TCP && rules[0].protocol != IPPROTO_UDP) ||
+	    !ssdk_flow_reverse(&rules[0].match, &rules[1].translated) ||
+	    !ssdk_flow_reverse(&rules[1].match, &rules[0].translated))
+		return -EOPNOTSUPP;
+	for (i = 0; i < 2; i++) {
+		const struct ssdk_flow_rule *rule = &rules[i];
+
+		/* SNAT original or DNAT reply: only the outbound source changes.
+		 * Hairpin, simultaneous source/destination NAT, port-only NAT and
+		 * pure routing remain in software until their DESS paths exist. */
+		if (rule->match.src == rule->translated.src ||
+		    rule->match.dst != rule->translated.dst ||
+		    rule->match.dport != rule->translated.dport)
+			continue;
+		pair.outbound = rule->match;
+		pair.translated = rule->translated;
+		pair.protocol = rule->protocol;
+		pair.outbound_direction = i;
+		*result = pair;
+		return 0;
+	}
+	return -EOPNOTSUPP;
+}
--- a/src/ref/ref_flow_path.c
+++ b/src/ref/ref_flow_path.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/inetdevice.h>
+#include <linux/rtnetlink.h>
+#include <net/arp.h>
+#include <net/route.h>
+#include "sw.h"
+#include "fal_fdb.h"
+#include "fal_misc.h"
+#include "fal_port_ctrl.h"
+#include "fal_portvlan.h"
+#include "ssdk_flow_path.h"
+struct device_path { struct net_device *gmac; u16 vid; };
+static int lower_path(struct ssdk_flow_resolver *resolver, struct net_device *dev,
+		      const u8 *mac, u16 action_vid, struct device_path *path)
+{
+	unsigned int depth, vlans = 0;
+	u16 vid = action_vid;
+	int id;
+	for (depth = 0; depth < 5; depth++) {
+		if (!dev || dev->type != ARPHRD_ETHER || !netif_running(dev) || dev->mtu != 1500)
+			return -EOPNOTSUPP;
+		if (netif_is_bridge_port(dev) && br_port_get_stp_state(dev) != BR_STATE_FORWARDING)
+			return -EAGAIN;
+		for (id = 0; id < 2; id++) if (dev == resolver->gmac[id]) break;
+		if (id < 2) {
+			if (!netif_carrier_ok(dev)) return -EAGAIN;
+			if (!vid) vid = resolver->vlans->default_vid[id];
+			if (!vid || vid >= 4095 || !(resolver->vlans->members[vid] & BIT(0)) ||
+			    !(resolver->vlans->tagged[vid] & BIT(0))) return -EOPNOTSUPP;
+			path->gmac = dev; path->vid = vid; return 0;
+		}
+		if (is_vlan_dev(dev)) {
+			if (++vlans > 1 || vlan_dev_vlan_proto(dev) != htons(ETH_P_8021Q) ||
+			    (vid && vid != vlan_dev_vlan_id(dev))) return -EOPNOTSUPP;
+			vid = vlan_dev_vlan_id(dev); dev = vlan_dev_real_dev(dev); continue;
+		}
+		if (netif_is_bridge_master(dev)) {
+			/* Bridge VLAN filtering can add/remove another tag and needs
+			 * a separate translation model. Keep that case in software. */
+			if (br_vlan_enabled(dev)) return -EOPNOTSUPP;
+			dev = br_fdb_find_port(dev, mac, 0); continue;
+		}
+		return -EOPNOTSUPP;
+	}
+	return -ELOOP;
+}
+static bool same_device_path(const struct device_path *a, const struct device_path *b)
+{
+	return a->gmac == b->gmac && a->vid == b->vid;
+}
+static int lookup_port(unsigned int dev, unsigned int members, struct ssdk_flow_path *path)
+{
+	fal_fdb_entry_t fdb = {};
+	a_bool_t link;
+	a_uint32_t vrf;
+	unsigned int map;
+	fdb.fid = path->vid; ether_addr_copy(fdb.addr.uc, path->neighbour);
+	if (fal_fdb_entry_search(dev, &fdb) != SW_OK) return -EAGAIN;
+	if (fdb.fid != path->vid || !ether_addr_equal(fdb.addr.uc, path->neighbour) ||
+	    fdb.is_multicast || fdb.dacmd != FAL_MAC_FRWRD || fdb.sacmd != FAL_MAC_FRWRD ||
+	    fdb.leaky_en || fdb.mirror_en || fdb.cross_pt_state) return -EOPNOTSUPP;
+	if (fdb.portmap_en) map = fdb.port.map;
+	else {
+		if (fdb.port.id > 5) return -EOPNOTSUPP;
+		map = BIT(fdb.port.id);
+	}
+	if (!is_power_of_2(map) || (map & ~0x3e) ||
+	    !(members & map)) return -EOPNOTSUPP;
+	path->port = __ffs(map);
+	if (fal_port_vrf_id_get(dev, path->port, &vrf) != SW_OK || vrf)
+		return -EOPNOTSUPP;
+	if (fal_port_link_status_get(dev, path->port, &link) != SW_OK || !link)
+		return -EAGAIN;
+	return 0;
+}
+static int private_prefix(struct net_device *dev, __be32 address, __be32 *base, __be32 *mask)
+{
+	struct in_device *in_dev;
+	struct in_ifaddr *ifa;
+	bool found = false;
+	int ret = -EOPNOTSUPP;
+	in_dev = in_dev_get(dev);
+	if (!in_dev) return ret;
+	in_dev_for_each_ifa_rtnl(ifa, in_dev) {
+		if (!ifa->ifa_mask || (address & ifa->ifa_mask) != (ifa->ifa_local & ifa->ifa_mask))
+			continue;
+		/* Do not guess between overlapping interface prefixes. */
+		if (found && (*mask != ifa->ifa_mask || *base != (ifa->ifa_local & ifa->ifa_mask)))
+			goto out;
+		*mask = ifa->ifa_mask; *base = ifa->ifa_local & ifa->ifa_mask; found = true;
+	}
+	if (found) ret = 0;
+out:
+	in_dev_put(in_dev); return ret;
+}
+int ssdk_flow_resolve_paths(void *ctx, const struct ssdk_flow_rule rules[2],
+			    struct ssdk_flow_path paths[2])
+{
+	struct ssdk_flow_resolver *resolver = ctx;
+	struct ssdk_flow_path result[2] = {};
+	struct device_path egress[2], action, ingress;
+	struct ssdk_flow_pair pair;
+	struct rtable *routes[2] = {};
+	struct neighbour *neighbour;
+	struct net_device *in;
+	struct net *net;
+	a_uint32_t max_frame;
+	__be32 base = 0, mask = 0;
+	unsigned int i, internal;
+	int ret;
+	ASSERT_RTNL();
+	if (!resolver || !rules || !paths || !resolver->gmac[0] || !resolver->gmac[1] ||
+	    !resolver->vlans || !resolver->prefix) return -EINVAL;
+	net = dev_net(resolver->gmac[0]);
+	if (!net_eq(net, dev_net(resolver->gmac[1]))) return -EOPNOTSUPP;
+	ret = ssdk_flow_pair(rules, &pair);
+	if (ret) return ret;
+	/* DESS has no usable L3-length ACL field. Only admit the normal MTU
+	 * while its global ingress frame limit excludes jumbo routed packets. */
+	if (fal_frame_max_size_get(resolver->dev, &max_frame) != SW_OK) return -EIO;
+	if (max_frame != 1518) return -EOPNOTSUPP;
+	for (i = 0; i < 2; i++) {
+		struct flowi4 flow = {
+			.daddr = rules[i].translated.dst, .saddr = rules[i].translated.src,
+			.flowi4_proto = rules[i].protocol, .flowi4_flags = FLOWI_FLAG_ANYSRC,
+			.fl4_sport = rules[i].translated.sport, .fl4_dport = rules[i].translated.dport,
+		};
+		if (!rules[i].egress || !net_eq(net, dev_net(rules[i].egress))) {
+			ret = -EOPNOTSUPP; goto out;
+		}
+		routes[i] = ip_route_output_key(net, &flow);
+		if (IS_ERR(routes[i])) { ret = PTR_ERR(routes[i]); routes[i] = NULL; goto out; }
+		if (routes[i]->rt_type != RTN_UNICAST || routes[i]->dst.lwtstate ||
+		    dst_mtu(&routes[i]->dst) != 1500 ||
+		    !ether_addr_equal(routes[i]->dst.dev->dev_addr, rules[i].source)) {
+			ret = -EOPNOTSUPP; goto out;
+		}
+		neighbour = dst_neigh_lookup(&routes[i]->dst, &flow.daddr);
+		if (!neighbour) { ret = -EAGAIN; goto out; }
+		ret = -EAGAIN;
+		read_lock_bh(&neighbour->lock);
+		if (neighbour->tbl == &arp_tbl && neighbour->dev == routes[i]->dst.dev &&
+		    (neighbour->nud_state & NUD_VALID) &&
+		    ether_addr_equal(neighbour->ha, rules[i].destination)) {
+			memcpy(&result[i].address, neighbour->primary_key, sizeof(result[i].address));
+			ether_addr_copy(result[i].neighbour, neighbour->ha); ret = 0;
+		}
+		read_unlock_bh(&neighbour->lock);
+		neigh_release(neighbour);
+		if (ret) goto out;
+		ether_addr_copy(result[i].router, rules[i].source);
+		ret = lower_path(resolver, routes[i]->dst.dev, result[i].neighbour, 0, &egress[i]);
+		if (ret) goto out;
+		ret = lower_path(resolver, rules[i].egress, result[i].neighbour,
+				 rules[i].vlan_push ? rules[i].egress_vid : 0, &action);
+		if (ret) goto out;
+		if (!same_device_path(&egress[i], &action)) { ret = -EOPNOTSUPP; goto out; }
+		result[i].vid = egress[i].vid;
+		ret = lookup_port(resolver->dev, resolver->vlans->members[result[i].vid], &result[i]);
+		if (ret) goto out;
+	}
+	for (i = 0; i < 2; i++) {
+		in = __dev_get_by_index(net, rules[i].ingress_ifindex);
+		ret = lower_path(resolver, in, result[1-i].neighbour,
+				 rules[i].vlan_match ? rules[i].ingress_vid : 0, &ingress);
+		if (ret) goto out;
+		if (!same_device_path(&ingress, &egress[1-i])) { ret = -EOPNOTSUPP; goto out; }
+	}
+	/* The private endpoint is reached by the canonical inbound direction.
+	 * Require a directly connected LAN prefix, not an inferred RFC1918 mask. */
+	internal = 1 - pair.outbound_direction;
+	if (result[internal].address != pair.outbound.src) { ret = -EOPNOTSUPP; goto out; }
+	ret = private_prefix(routes[internal]->dst.dev, pair.outbound.src, &base, &mask);
+	if (ret) goto out;
+	/* The same global classifier cannot regard the public/remote side as
+	 * private. Such overlapping/hairpin arrangements stay in software. */
+	if ((pair.translated.src & mask) == base || (pair.outbound.dst & mask) == base) {
+		ret = -EOPNOTSUPP; goto out;
+	}
+	ret = resolver->prefix(resolver->ctx, base, mask);
+	if (!ret) memcpy(paths, result, sizeof(result));
+out:
+	for (i = 0; i < 2; i++) if (routes[i]) ip_rt_put(routes[i]);
+	return ret;
+}
+
+int ssdk_flow_path_alive(unsigned int dev, const struct ssdk_flow_path *path)
+{
+	struct ssdk_flow_path probe;
+	a_uint32_t max_frame;
+	int ret;
+	if (!path || !path->port || path->port > 5) return -EINVAL;
+	if (fal_frame_max_size_get(dev, &max_frame) != SW_OK || max_frame != 1518) return -EIO;
+	probe = *path;
+	ret = lookup_port(dev, BIT(path->port), &probe);
+	if (ret) return ret;
+	return probe.port == path->port ? 0 : -ESTALE;
+}
--- a/src/ref/ref_flow_profile.c
+++ b/src/ref/ref_flow_profile.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/err.h>
+#include <linux/in.h>
+#include <linux/slab.h>
+#include "sw.h"
+#include "fal_acl.h"
+#include "fal_ip.h"
+#include "fal_nat.h"
+#include "dess_acl.h"
+#include "ssdk_flow_profile.h"
+#define PROFILE_PORTS 6
+#define PROFILE_WINDOWS FAL_ACL_UDF_TYPE_BUTT
+struct ssdk_flow_profile {
+	unsigned int dev;
+	bool attempted, restored, ready, prefix_attempted, prefix_ready;
+	a_uint32_t original_base, original_mask, base, mask;
+	a_bool_t acl;
+	a_uint32_t learn[PROFILE_PORTS];
+	struct { a_uint32_t offset, length; } udf[PROFILE_PORTS][PROFILE_WINDOWS];
+	fal_napt_mode_t mode;
+	fal_fwd_cmd_t miss;
+};
+struct ssdk_flow_profile *ssdk_flow_profile_create(unsigned int dev)
+{
+	struct ssdk_flow_profile *p;
+	unsigned int port, window;
+	int error = -EIO;
+	sw_error_t rv;
+	if (dev >= SW_MAX_NR_DEV) return ERR_PTR(-EINVAL);
+	rv = dess_acl_native_empty(dev);
+	if (rv != SW_OK) return ERR_PTR(rv == SW_BUSY ? -EBUSY : -EIO);
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	if (!p) return ERR_PTR(-ENOMEM);
+	p->dev = dev;
+	if (fal_acl_status_get(dev, &p->acl) != SW_OK ||
+	    fal_napt_mode_get(dev, &p->mode) != SW_OK ||
+	    fal_nat_unk_session_cmd_get(dev, &p->miss) != SW_OK ||
+	    fal_ip_vrf_base_addr_get(dev, 0, &p->original_base) != SW_OK ||
+	    fal_ip_vrf_base_mask_get(dev, 0, &p->original_mask) != SW_OK) goto fail;
+	for (port = 0; port < PROFILE_PORTS; port++) {
+		if (fal_ip_pt_arp_learn_get(dev, port, &p->learn[port]) != SW_OK) goto fail;
+		for (window = 0; window < PROFILE_WINDOWS; window++) {
+			if (fal_acl_port_udf_profile_get(dev, port, window,
+			    &p->udf[port][window].offset, &p->udf[port][window].length) != SW_OK) goto fail;
+			/* Do not change a profile potentially used by existing policy. */
+			if (p->udf[port][window].length) { error = -EBUSY; goto fail; }
+		}
+	}
+	return p;
+fail:
+	kfree(p); return ERR_PTR(error);
+}
+static int set_udf(struct ssdk_flow_profile *p, unsigned int port,
+		   unsigned int window, a_uint32_t offset, a_uint32_t length)
+{
+	a_uint32_t got_offset, got_length;
+	if (fal_acl_port_udf_profile_set(p->dev, port, window, offset, length) != SW_OK ||
+	    fal_acl_port_udf_profile_get(p->dev, port, window, &got_offset, &got_length) != SW_OK ||
+	    got_offset != offset || got_length != length) return -EIO;
+	return 0;
+}
+static int set_learn(struct ssdk_flow_profile *p, unsigned int port, a_uint32_t flags)
+{
+	a_uint32_t got;
+	if (fal_ip_pt_arp_learn_set(p->dev, port, flags) != SW_OK ||
+	    fal_ip_pt_arp_learn_get(p->dev, port, &got) != SW_OK || got != flags) return -EIO;
+	return 0;
+}
+static int set_mode(struct ssdk_flow_profile *p, fal_napt_mode_t mode)
+{
+	fal_napt_mode_t got;
+	/* DESS maps PORT_STRICT and SYNMETRIC to the same hardware value. */
+	if (fal_napt_mode_set(p->dev, mode) != SW_OK ||
+	    fal_napt_mode_get(p->dev, &got) != SW_OK) return -EIO;
+	if (mode == FAL_NAPT_SYNMETRIC) mode = FAL_NAPT_PORT_STRICT;
+	if (got == FAL_NAPT_SYNMETRIC) got = FAL_NAPT_PORT_STRICT;
+	return mode == got ? 0 : -EIO;
+}
+static int set_miss(struct ssdk_flow_profile *p, fal_fwd_cmd_t miss)
+{
+	fal_fwd_cmd_t got;
+	if (fal_nat_unk_session_cmd_set(p->dev, miss) != SW_OK ||
+	    fal_nat_unk_session_cmd_get(p->dev, &got) != SW_OK || got != miss) return -EIO;
+	return 0;
+}
+static int set_acl(struct ssdk_flow_profile *p, a_bool_t enable)
+{
+	a_bool_t got;
+	if (fal_acl_status_set(p->dev, enable) != SW_OK ||
+	    fal_acl_status_get(p->dev, &got) != SW_OK || got != enable) return -EIO;
+	return 0;
+}
+int ssdk_flow_profile_apply(struct ssdk_flow_profile *p)
+{
+	unsigned int port, window, length;
+	if (!p) return -EINVAL;
+	if (p->attempted) return -EBUSY;
+	p->attempted = true;
+	/* Suppress autonomous host insertion before creating any owned host. */
+	for (port = 0; port < PROFILE_PORTS; port++)
+		if (set_learn(p, port, 0)) return -EIO;
+	for (port = 0; port < PROFILE_PORTS; port++)
+		for (window = 0; window < PROFILE_WINDOWS; window++) {
+			length = window == FAL_ACL_UDF_TYPE_L3 ? 9 :
+				 window == FAL_ACL_UDF_TYPE_L4 ? 7 : 0;
+			if (set_udf(p, port, window, 0, length)) return -EIO;
+		}
+	if (set_mode(p, FAL_NAPT_SYNMETRIC) || set_miss(p, FAL_MAC_RDT_TO_CPU) ||
+	    set_acl(p, A_TRUE)) return -EIO;
+	p->ready = true;
+	return 0;
+}
+static int set_prefix(struct ssdk_flow_profile *p, a_uint32_t base, a_uint32_t mask)
+{
+	a_uint32_t got;
+	int ret = 0;
+	/* DESS classifies NAT through VRF 0 (0x484/0x488), not the older
+	 * PRVIP 0x470/0x474 registers. Keep the gate closed across both words. */
+	if (fal_ip_vrf_base_addr_set(p->dev, 0, base) != SW_OK ||
+	    fal_ip_vrf_base_addr_get(p->dev, 0, &got) != SW_OK || got != base) ret = -EIO;
+	if (fal_ip_vrf_base_mask_set(p->dev, 0, mask) != SW_OK ||
+	    fal_ip_vrf_base_mask_get(p->dev, 0, &got) != SW_OK || got != mask) ret = -EIO;
+	return ret;
+}
+int ssdk_flow_profile_prefix(void *ctx, __be32 base, __be32 mask)
+{
+	struct ssdk_flow_profile *p = ctx;
+	u32 address = ntohl(base), netmask = ntohl(mask), hostmask = ~netmask;
+	int ret;
+	if (!p || !p->ready || p->restored) return -ESHUTDOWN;
+	if (!netmask || (hostmask & (hostmask + 1)) || (address & hostmask)) return -EINVAL;
+	if (p->prefix_attempted) {
+		if (!p->prefix_ready) return -EIO;
+		return p->base == address && p->mask == netmask ? 0 : -EOPNOTSUPP;
+	}
+	p->prefix_attempted = true; p->base = address; p->mask = netmask;
+	ret = set_prefix(p, address, netmask);
+	if (!ret) p->prefix_ready = true;
+	return ret;
+}
+int ssdk_flow_profile_prefix_reset(struct ssdk_flow_profile *p)
+{
+	int ret;
+	if (!p) return -EINVAL;
+	if (!p->prefix_attempted) return 0;
+	p->prefix_ready = false;
+	ret = set_prefix(p, p->original_base, p->original_mask);
+	if (!ret) p->prefix_attempted = false;
+	return ret;
+}
+int ssdk_flow_profile_restore(struct ssdk_flow_profile *p)
+{
+	unsigned int port, window;
+	int error = 0;
+	if (!p) return -EINVAL;
+	if (!p->attempted || p->restored) return 0;
+	p->ready = false;
+	if (ssdk_flow_profile_prefix_reset(p)) error = -EIO;
+	/* Try every restoration even after an error. Keep the handle and gate
+	 * closed until the full snapshot has been written and read back. */
+	for (port = 0; port < PROFILE_PORTS; port++)
+		for (window = 0; window < PROFILE_WINDOWS; window++)
+			if (set_udf(p, port, window, p->udf[port][window].offset,
+			    p->udf[port][window].length)) error = -EIO;
+	if (set_mode(p, p->mode)) error = -EIO;
+	if (set_miss(p, p->miss)) error = -EIO;
+	for (port = 0; port < PROFILE_PORTS; port++)
+		if (set_learn(p, port, p->learn[port])) error = -EIO;
+	if (!error) p->restored = true;
+	return error;
+}
+int ssdk_flow_profile_destroy(struct ssdk_flow_profile *p)
+{
+	if (!p) return 0;
