+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/slab.h>
+#include "ssdk_flow_state.h"
+#define FLOW_ENTRIES (SSDK_FLOW_PENDING + 2 * SSDK_FLOW_COUNTERS)
+#define PENDING_LIFETIME (5 * HZ)
+struct ssdk_flow_entry {
+	bool used;
+	unsigned long cookie, expires;
+	int slot;
+	struct ssdk_flow_rule rule;
+};
+struct ssdk_flow_slot {
+	bool used, quarantine;
+	unsigned int entry[2], outbound;
+	struct ssdk_flow_counts previous;
+	struct ssdk_flow_pair pair;
+};
+struct ssdk_flow_state {
+	struct mutex lock;
+	const struct ssdk_flow_ops *ops;
+	void *ctx;
+	bool closed;
