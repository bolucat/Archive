Subject: [PATCH] ssdk: write ACL source filters before software commit

The public setter requires a committed entry and mutates its cached state.
ACL transactions need to program new and empty slots without publishing
partial software changes. Split the raw register write from the public API.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/src/hsl/dess/dess_acl.c
+++ b/src/hsl/dess/dess_acl.c
@@ -67,6 +67,10 @@
                       a_uint32_t flt_idx);
 
 static sw_error_t
+_dess_acl_src_filter_write(a_uint32_t dev_id, a_uint32_t rule_id,
+                           a_bool_t enable);
+
+static sw_error_t
 _dess_acl_rule_src_filter_sts_set(a_uint32_t dev_id,
                                   a_uint32_t rule_id, a_bool_t enable);
 
@@ -689,7 +693,7 @@
     else
         rv = _dess_filter_valid_set(dev_id, index, 0);
     SW_RTN_ON_ERROR(rv);
-    return _dess_acl_rule_src_filter_sts_set(dev_id, index, !rule->src_flt_dis);
+    return _dess_acl_src_filter_write(dev_id, index, !rule->src_flt_dis);
 }
 
 static sw_error_t
@@ -1430,46 +1434,46 @@
     return SW_OK;
 }
 
+/* Transactional writes also cover new or cleared slots. Do not consult or
+ * mutate the committed software table until the complete ACL update succeeds.
+ */
+static sw_error_t
+_dess_acl_src_filter_write(a_uint32_t dev_id, a_uint32_t rule_id,
+                           a_bool_t enable)
+{
+    sw_error_t rv;
+    a_uint32_t reg = 0, regIdx = rule_id >> 5;
+
+    HSL_REG_ENTRY_GET(rv, dev_id, ACL_FWD_SRC_FILTER_CTL0, regIdx,
+                      (a_uint8_t *) (&reg), sizeof (a_uint32_t));
+    SW_RTN_ON_ERROR(rv);
+    if (enable)
+        reg |= (1U << (rule_id & 0x1f));
+    else
+        reg &= ~(1U << (rule_id & 0x1f));
+    HSL_REG_ENTRY_SET(rv, dev_id, ACL_FWD_SRC_FILTER_CTL0, regIdx,
+                      (a_uint8_t *) (&reg), sizeof (a_uint32_t));
+    return rv;
+}
+
 static sw_error_t
 _dess_acl_rule_src_filter_sts_set(a_uint32_t dev_id,
                                   a_uint32_t rule_id, a_bool_t enable)
 {
     sw_error_t rv;
-    a_uint32_t reg = 0, regIdx;
     dess_acl_rule_t *sw_rule;
 
     HSL_DEV_ID_CHECK(dev_id);
-
+    if (rule_id >= DESS_MAX_FILTER)
+        return SW_BAD_PARAM;
     sw_rule = &sw_rule_ent[dev_id][rule_id];
     if (!(ENT_USED & sw_rule->status))
-    {
         return SW_NOT_FOUND;
-    }
-
-    regIdx = rule_id >> 5;
-
-    HSL_REG_ENTRY_GET(rv, dev_id, ACL_FWD_SRC_FILTER_CTL0, regIdx,
-                      (a_uint8_t *) (&reg), sizeof (a_uint32_t));
-    SW_RTN_ON_ERROR(rv);
-
-    if (A_TRUE == enable)
-    {
-        reg |= (0x1 << (rule_id & 0x1F));
-        sw_rule->src_flt_dis = 0;
-    }
-    else if (A_FALSE == enable)
-    {
-        reg &= ~(0x1 << (rule_id & 0x1F));
-        sw_rule->src_flt_dis = 1;
-    }
-    else
-    {
+    if (enable != A_TRUE && enable != A_FALSE)
         return SW_BAD_PARAM;
-    }
-
-    HSL_REG_ENTRY_SET(rv, dev_id, ACL_FWD_SRC_FILTER_CTL0, regIdx,
-                      (a_uint8_t *) (&reg), sizeof (a_uint32_t));
-
+    rv = _dess_acl_src_filter_write(dev_id, rule_id, enable);
+    if (rv == SW_OK)
+        sw_rule->src_flt_dis = !enable;
     return rv;
 }
 
