--- a/edma_switch.c
+++ b/edma_switch.c
@@ -0,0 +1,255 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/if_vlan.h>
+#include <linux/delay.h>
+#include <linux/rcupdate.h>
+#include <linux/slab.h>
+#include "edma.h"
+#include <ssdk_edma.h>
+
+extern struct net_device *edma_netdev[EDMA_MAX_PORTID_SUPPORTED];
+struct edma_switch_table {
+	struct rcu_head rcu;
+	struct ssdk_edma_vlan_config config;
+	bool carrier;
+};
+static struct edma_switch_table __rcu *edma_switch_current;
+static struct edma_switch_table *edma_switch_pending;
+static bool edma_switch_paused;
+static bool edma_switch_registered;
+
+bool edma_switch_managed(void)
+{
+	return rcu_access_pointer(edma_switch_current) != NULL;
+}
+
+bool edma_switch_carrier(void)
+{
+	struct edma_switch_table *table;
+	bool up;
+
+	rcu_read_lock();
+	table = rcu_dereference(edma_switch_current);
+	up = table && table->carrier && !READ_ONCE(edma_switch_paused);
+	rcu_read_unlock();
+	return up;
+}
+
+static void edma_switch_resume(void)
+{
+	int i;
+
+	WRITE_ONCE(edma_switch_paused, false);
+	for (i = 0; i < 2; i++)
+		if (edma_netdev[i] && netif_running(edma_netdev[i]) &&
+		    netif_carrier_ok(edma_netdev[i]))
+			netif_tx_wake_all_queues(edma_netdev[i]);
+}
+
+static int edma_switch_drain(void)
+{
+	int attempt, queue;
+
+	for (attempt = 0; attempt < 100; attempt++) {
+		bool drained = true;
+
+		for (queue = 0; queue < EDMA_MAX_TRANSMIT_QUEUE; queue++) {
+			u32 indices;
+
+			edma_read_reg(EDMA_REG_TPD_IDX_Q(queue), &indices);
+			if ((indices & EDMA_TPD_PROD_IDX_MASK) !=
+			    ((indices >> EDMA_TPD_CONS_IDX_SHIFT) & EDMA_TPD_CONS_IDX_MASK)) {
+				drained = false;
+				break;
+			}
+		}
+		if (drained)
+			return 0;
+		msleep(1);
+	}
+	return -ETIMEDOUT;
+}
+
+static int edma_switch_event(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct ssdk_edma_vlan_config *config = data;
+	struct edma_switch_table *old;
+	int i, ret;
+	bool cpu_active = false;
+
+	switch (event) {
+	case SSDK_EDMA_PREPARE:
+		if (WARN_ON(edma_switch_pending))
+			return notifier_from_errno(-EBUSY);
+		edma_switch_pending = kmalloc(sizeof(*edma_switch_pending), GFP_KERNEL);
+		if (!edma_switch_pending)
+			return notifier_from_errno(-ENOMEM);
+		edma_switch_pending->config = *config;
+		WRITE_ONCE(edma_switch_paused, true);
+		for (i = 0; i < 2; i++)
+			if (edma_netdev[i])
+				netif_tx_disable(edma_netdev[i]);
+		synchronize_net();
+		ret = edma_switch_drain();
+		return notifier_from_errno(ret);
+	case SSDK_EDMA_ABORT:
+		kfree(edma_switch_pending);
+		edma_switch_pending = NULL;
+		edma_switch_resume();
+		break;
+	case SSDK_EDMA_COMMIT:
+	case SSDK_EDMA_FAILED:
+		if (WARN_ON(!edma_switch_pending))
+			return NOTIFY_BAD;
+		/* FAILED supplies an empty map; never resume the previous mapping
+		 * after partially successful switch register writes. */
+		edma_switch_pending->config = *config;
+		for (i = 1; i < SSDK_EDMA_VIDS; i++)
+			if ((config->tagged[i] & 1) && (config->members[i] & 0x3e))
+				cpu_active = true;
+		edma_switch_pending->carrier = cpu_active;
+		old = rcu_replace_pointer(edma_switch_current, edma_switch_pending, true);
+		edma_switch_pending = NULL;
+		for (i = 0; i < 2; i++) {
+			struct edma_adapter *adapter;
+			u16 vid = config->default_vid[i];
+
+			if (!edma_netdev[i])
+				continue;
+			adapter = netdev_priv(edma_netdev[i]);
+			WRITE_ONCE(adapter->default_vlan_tag, vid);
+			WRITE_ONCE(adapter->dp_bitmap, config->members[vid] & 0x3e);
+			/* The GMAC is a CPU link. Physical port carrier is reported by
+			 * SSDK; a fixed PHY cannot represent a changing VLAN/trunk. */
+			mutex_lock(&adapter->poll_mutex);
+			adapter->poll_required = 0;
+			mutex_unlock(&adapter->poll_mutex);
+			if (cpu_active)
+				netif_carrier_on(edma_netdev[i]);
+			else
+				netif_carrier_off(edma_netdev[i]);
+		}
+		if (old)
+			kfree_rcu(old, rcu);
+		edma_switch_resume();
+		break;
+	}
+	return NOTIFY_OK;
+}
+static struct notifier_block edma_switch_notifier = { .notifier_call = edma_switch_event };
+
+int edma_switch_register(void)
+{
+	int ret;
+
+	WRITE_ONCE(edma_switch_paused, false);
+	ret = ssdk_edma_register_notifier(&edma_switch_notifier);
+
+	if (!ret)
+		edma_switch_registered = true;
+	return ret;
+}
+
+void edma_switch_unregister(void)
+{
+	struct edma_switch_table *old;
+
+	if (!edma_switch_registered)
+		return;
+	ssdk_edma_unregister_notifier(&edma_switch_notifier);
+	edma_switch_registered = false;
+	WRITE_ONCE(edma_switch_paused, true);
+	old = rcu_replace_pointer(edma_switch_current, NULL, true);
+	synchronize_net();
+	kfree(old);
+	/* Ensure callbacks queued by previous commits finish before module exit. */
+	rcu_barrier();
+}
+
+struct net_device *edma_switch_rx(struct edma_common_info *cinfo, u8 port,
+				 u16 tag, bool tagged, u16 *strip_vid)
+{
+	struct edma_switch_table *table;
+	struct net_device *dev = NULL;
+	u16 vid = tag & VLAN_VID_MASK;
+	int i, selected = -1;
+
+	if (READ_ONCE(edma_switch_paused))
+		return NULL;
+	rcu_read_lock();
+	table = rcu_dereference(edma_switch_current);
+	if (!table) {
+		dev = READ_ONCE(cinfo->portid_netdev_lookup_tbl[port]);
+		if (dev)
+			*strip_vid = ((struct edma_adapter *)netdev_priv(dev))->default_vlan_tag;
+		goto out;
+	}
+	if (!tagged || !(table->config.members[vid] & BIT(port)) ||
+	    !(table->config.tagged[vid] & BIT(0)))
+		goto out;
+	/* Respect an explicit Linux VLAN interface on either GMAC. Two copies
+	 * of the same VID on the shared CPU port are ambiguous and are dropped. */
+	for (i = 0; i < 2; i++) {
+		if (edma_netdev[i] && __vlan_find_dev_deep_rcu(edma_netdev[i], htons(ETH_P_8021Q), vid)) {
+			if (selected >= 0)
+				goto out;
+			selected = i;
+		}
+	}
+	if (selected >= 0) {
+		dev = edma_netdev[selected];
+		*strip_vid = 0;
+		goto out;
+	}
+	for (i = 0; i < 2; i++)
+		if (vid && vid == table->config.default_vid[i]) {
+			dev = edma_netdev[i];
+			*strip_vid = vid;
+			goto out;
+		}
+	/* Untargeted tagged VLANs arrive on the LAN CPU trunk. */
+	dev = edma_netdev[1];
+	*strip_vid = 0;
+out:
+	rcu_read_unlock();
+	return dev;
+}
+
+bool edma_switch_tx(struct net_device *dev, struct sk_buff *skb,
+		    u16 *default_vid, u16 *ports)
+{
+	struct edma_adapter *adapter = netdev_priv(dev);
+	struct edma_switch_table *table;
+	u16 vid;
+	bool allowed = false;
+	int index = dev == edma_netdev[0] ? 0 : 1;
+
+	if (READ_ONCE(edma_switch_paused))
+		return false;
+	rcu_read_lock();
+	table = rcu_dereference(edma_switch_current);
+	*default_vid = table ? table->config.default_vid[index] : READ_ONCE(adapter->default_vlan_tag);
+	vid = *default_vid;
+	if (skb_vlan_tag_present(skb)) {
+		if (skb->vlan_proto != htons(ETH_P_8021Q) ||
+		    skb->protocol == htons(ETH_P_8021Q) ||
+		    skb->protocol == htons(ETH_P_8021AD))
+			goto out;
+		vid = skb_vlan_tag_get_id(skb);
+	} else if (skb->protocol == htons(ETH_P_8021Q)) {
+		struct vlan_ethhdr header, *vh;
+
+		vh = skb_header_pointer(skb, 0, sizeof(header), &header);
+		if (!vh || vh->h_vlan_encapsulated_proto == htons(ETH_P_8021Q) ||
+		    vh->h_vlan_encapsulated_proto == htons(ETH_P_8021AD))
+			goto out;
+		vid = ntohs(vh->h_vlan_TCI) & VLAN_VID_MASK;
+		*default_vid = 0; /* already tagged: do not insert a second tag */
+	} else if (skb->protocol == htons(ETH_P_8021AD)) {
+		goto out;
+	}
+	*ports = table ? table->config.members[vid] & 0x3e : READ_ONCE(adapter->dp_bitmap);
+	allowed = *ports && (!table || (table->config.tagged[vid] & 1));
+out:
+	rcu_read_unlock();
+	return allowed;
+}
