+/* Serialize group updates: parsing must not publish invalid masks. */
+static DEFINE_MUTEX(edma_group_mutex);
+
+static int edma_parse_group_bmp(const struct ctl_table *table, int write,
+		void __user *buffer, size_t *lenp, loff_t *ppos, int group)
+{
+	struct ctl_table temporary = *table;
+	struct edma_adapter *other;
+	int candidate = *(u32 *)table->data;
+	int ret;
+
+	temporary.data = &candidate;
+	ret = proc_dointvec(&temporary, write, buffer, lenp, ppos);
+	if (ret || !write)
+		return ret;
+	if (candidate < 0 || (candidate & ~0x3e))
+		return -EINVAL;
+	if (edma_netdev[1 - group]) {
+		other = netdev_priv(edma_netdev[1 - group]);
+		if (candidate & other->dp_bitmap)
+			return -EBUSY;
+	}
+	*(u32 *)table->data = candidate;
+	return 0;
+}
+
+static void edma_publish_group(struct edma_common_info *cinfo,
+		struct net_device *dev, u32 mask)
+{
+	int port;
+
+	for (port = 1; port <= EDMA_MAX_PORTID_SUPPORTED; port++) {
+		if (mask & BIT(port))
